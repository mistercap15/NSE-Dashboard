#!/usr/bin/env python3
"""The 5-minute bot is INTRADAY. It must never carry a position overnight.

WHY THIS FILE EXISTS. On 8 Sep 2026 the bot filled at 15:14 and held overnight.
On 9 Sep the market opened 42.7 points BELOW the frozen stop; the bot re-placed
that stop anyway — a SELL trigger above the market, which protects nothing — and
the trade ran to −217 points. Planned risk 31 points (₹1,986); actual ₹14,124.

The backtest then showed it was structural, not luck: 36 of 37 gap-through stops
were overnight, and every one had been filled AT the stop price in the results.
Correcting that alone dropped PF 1.46 → 1.24 and doubled max drawdown
(₹44k → ₹93k). Squaring off intraday restores PF to 1.47 and halves the drawdown
to ₹52k, because it deletes the gap-through category instead of surviving it.

So the property under test is not "the exit works". It is: NO PATH LEAVES A
POSITION OPEN PAST THE CLOSE, and the bot never believes it is flat when it is
not.
"""
import json
import os
import sys
import tempfile
from datetime import datetime, time as dtime, timedelta, timezone

TMP = tempfile.mkdtemp()
os.environ.update({
    "EXECUTOR_5M_STATE": os.path.join(TMP, "five.json"),
    "HOURLY_STATE": os.path.join(TMP, "hourly.json"),
    "PEER_STATE": os.path.join(TMP, "ib.json"),
    "CONTRACT_LOCK": os.path.join(TMP, "lock"),
    "APP_PIN": "test",
})

sys.path.insert(0, "/Users/khilanpatel/Desktop/Live Projects/nifty-executor")

import executor_5m as E
import upstox_orders as ux

IST = timezone(timedelta(hours=5, minutes=30))
KEY = "NSE_FO|68407"
LOT = 65
ENTRY, STOP, TARGET = 23747.3, 23716.74, 23783.3

CALLS: list = []
PLACED: list = []
passed = failed = 0


def check(label, cond, detail=""):
    global passed, failed
    if cond:
        passed += 1
        print(f"  ok   {label}")
    else:
        failed += 1
        print(f"  FAIL {label}   {detail}")


E.tg = lambda t: CALLS.append(t)
for _n in ("place_limit_buy", "place_limit_sell", "place_sl", "place_sl_m",
           "cancel_order", "modify_order"):
    def _mk(n):
        def f(*a, **k):
            PLACED.append((n, a, k))
            return f"OID-{n}"
        return f
    setattr(ux, _n, _mk(_n))

json.dump({}, open(os.environ["HOURLY_STATE"], "w"))


def at(hh, mm):
    """Pin the clock. Both rules are time-based, so the tests must own time."""
    now = datetime(2026, 9, 10, hh, mm, tzinfo=IST)
    E.past_no_entry_cutoff = lambda n=None: now.time() >= E.NO_ENTRY_AFTER
    E.must_square_off = lambda n=None: now.time() >= E.SQUARE_OFF_AT
    return now


def payload(armed=True, entry=ENTRY):
    expiry = int((datetime.now(tz=IST) + timedelta(days=19)).timestamp() * 1000)
    return {"tokenValid": True, "error": None,
            "contract": {"instrumentKey": KEY, "lotSize": LOT, "tickSize": 10,
                         "tradingSymbol": "NIFTY FUT 29 SEP 26", "expiry": expiry},
            "signal": {"entryValid": armed, "fibEntry": entry, "stopPrice": STOP,
                       "targetPrice": TARGET, "asOf": "bar-1", "lastClose": 23740.0}}


def world(position=0, avg=None, book=None):
    book = list(book or [])
    if position and not any((o.get("tag") or "") == E.TAG_ENTRY
                            and (o.get("status") or "") == "complete" for o in book):
        book.append({"instrument_token": KEY, "status": "complete", "tag": E.TAG_ENTRY,
                     "order_id": "FILLED", "price": avg, "average_price": avg})
    ux.get_positions = lambda t: ([{"instrument_token": KEY, "quantity": position,
                                    "average_price": avg}] if position else [])
    ux.get_order_book = lambda t: list(book)
    ux.get_quote = lambda t, k: {"depth": {"buy": [{"price": 23735.0}]}, "last_price": 23740.0}


def run(position=0, avg=None, book=None, state=None, **kw):
    CALLS.clear(); PLACED.clear()
    try:
        os.remove(os.environ["CONTRACT_LOCK"])
    except OSError:
        pass
    world(position, avg, book)
    st = state if state is not None else {}
    E.reconcile("tok", payload(**kw), st)
    return st


def of(kind):
    return [p for p in PLACED if p[0] == kind]


# place_limit_sell serves BOTH the target and the exit, so "a sell was placed"
# is not the same question as "it exited". Split them by tag — args are
# (token, key, qty, price, product, tag).
def exits():
    return [p for p in PLACED if p[0] == "place_limit_sell" and p[1][5] == E.TAG_EXIT]


def targets():
    return [p for p in PLACED if p[0] == "place_limit_sell" and p[1][5] == E.TAG_TARGET]


def holding_state():
    return {"entry_bar": "2026-09-10T14:35:00+05:30", "instrument": KEY,
            "entry_price": ENTRY, "stop": STOP, "target": TARGET, "bars": 3,
            "entry_fill": {"price": ENTRY, "stop": STOP, "target": TARGET, "at": "bar-1"}}


print("═" * 76)
print("  The 5-minute bot is intraday — no position may cross the close")
print("═" * 76)
E.LIVE = True
try:
    print(f"\n  cut-off {E.NO_ENTRY_AFTER.strftime('%H:%M')} · "
          f"square-off {E.SQUARE_OFF_AT.strftime('%H:%M')} · close 15:30\n")

    # ── RULE 1: no new entries late ──────────────────────────────────────────
    print("── 1. no new entries after the cut-off ──")
    at(11, 30)
    run()
    check("11:30 — mid-session, it opens normally", len(of("place_limit_buy")) == 1, PLACED)

    at(14, 59)
    run(entry=23750.0)
    check("14:59 — one minute before the cut-off, still opens",
          len(of("place_limit_buy")) == 1, PLACED)

    at(15, 0)
    run(entry=23751.0)
    check("15:00 — the cut-off itself, opens NOTHING", not of("place_limit_buy"), PLACED)
    check("  ...and says why", any("No new trades after" in c for c in CALLS), CALLS[:1])

    at(15, 25)
    run(entry=23752.0)
    check("15:25 — still nothing", not of("place_limit_buy"), PLACED)

    # An entry placed before the cut-off must not be left sitting: a fill at
    # 15:25 is an overnight hold by another name.
    at(15, 5)
    run(book=[{"instrument_token": KEY, "tag": E.TAG_ENTRY, "status": "open",
               "order_id": "LATE-1", "price": ENTRY}])
    check("a buy order left resting past the cut-off is CANCELLED",
          any("LATE-1" in str(p[1]) for p in of("cancel_order")), PLACED)
    check("  ...and no new one replaces it", not of("place_limit_buy"), PLACED)

    # ── RULE 2: square off ───────────────────────────────────────────────────
    print("\n── 2. any open position is squared off before the close ──")
    at(14, 30)
    st = run(position=LOT, avg=ENTRY, state=holding_state())
    check("14:30 — holding, well before square-off: no exit yet", not exits(), PLACED)
    check("  ...and it protects normally — stop and target both go on",
          of("place_sl") and targets(), PLACED)

    at(15, 20)
    st = run(position=LOT, avg=ENTRY, state=holding_state())
    sells = exits()
    check("15:20 — an exit IS placed", len(sells) == 1, PLACED)
    check("  ...priced to fill, at or below the bid (23735)",
          sells and sells[0][1][3] <= 23735.0, sells)
    check("  ...for the whole position", sells and sells[0][1][2] == LOT, sells)
    # It should not place a bracket it is about to cancel.
    check("  ...and it does NOT place a fresh stop/target on the way out",
          not of("place_sl") and not targets(), PLACED)
    check("  ...and it says it is squaring off, not timing out",
          any("SQUARING OFF" in c for c in CALLS), CALLS[:2])

    # The brackets must come off FIRST or the exit races them.
    st = run(position=LOT, avg=ENTRY, state=holding_state(),
             book=[{"instrument_token": KEY, "tag": E.TAG_STOP, "status": "open", "order_id": "S1"},
                   {"instrument_token": KEY, "tag": E.TAG_TARGET, "status": "open", "order_id": "T1"}])
    ids = str(of("cancel_order"))
    check("the stop is cancelled before the exit goes out", "S1" in ids, PLACED)
    check("  ...and the target too", "T1" in ids, PLACED)

    at(15, 25)
    st = run(position=LOT, avg=ENTRY, state=holding_state())
    check("15:25 — past square-off, it is still trying", len(exits()) == 1, PLACED)

    # ── THE ONE THAT MATTERS MOST ────────────────────────────────────────────
    print("\n── 3. it never believes it is flat on an unconfirmed exit ──")
    at(15, 20)
    st = holding_state()
    run(position=LOT, avg=ENTRY, state=st)
    check("after placing the exit, the trade is STILL recorded as open",
          bool(st.get("entry_bar")), st)
    check("  ...because only the exchange decides that", st.get("entry_price") == ENTRY, st)

    # Exit on the book, still holding → re-priced, not abandoned.
    st = holding_state(); st["exit_attempts"] = 1
    run(position=LOT, avg=ENTRY, state=st,
        book=[{"instrument_token": KEY, "tag": E.TAG_EXIT, "status": "open",
               "order_id": "X1", "price": 23730.0}])
    check("an unfilled exit is cancelled and re-priced",
          any("X1" in str(p[1]) for p in of("cancel_order")), PLACED)
    check("  ...and a fresh one goes out", len(exits()) == 1, PLACED)

    # Out of attempts → SHOUT. Do not go quiet on a position about to carry.
    st = holding_state(); st["exit_attempts"] = E.TIMEOUT_MAX_ATTEMPTS
    run(position=LOT, avg=ENTRY, state=st,
        book=[{"instrument_token": KEY, "tag": E.TAG_EXIT, "status": "open",
               "order_id": "X9", "price": 23730.0}])
    check("out of attempts → it stops trying and alerts", not exits(), PLACED)
    check("  ...loudly, naming the overnight risk",
          any("WILL CARRY OVERNIGHT" in c for c in CALLS), CALLS[:1])
    check("  ...and tells you to close it by hand",
          any("BY HAND" in c for c in CALLS), CALLS[:1])
    check("  ...and STILL does not mark the trade closed", bool(st.get("entry_bar")), st)

    # ── 4. the rules do not fire outside their windows ───────────────────────
    print("\n── 4. no side effects in the rest of the session ──")
    at(9, 20)
    st = run(position=LOT, avg=ENTRY, state=holding_state())
    check("09:20 — holding, no exit", not exits(), PLACED)
    check("  ...brackets placed as normal", of("place_sl"), PLACED)
    at(12, 0)
    run()
    check("12:00 — flat, opens normally", len(of("place_limit_buy")) == 1, PLACED)

    # ── 5. the timeout still works on its own ────────────────────────────────
    print("\n── 5. the time limit still fires independently ──")
    at(11, 0)
    st = holding_state(); st["bars"] = E.TIMEOUT_BARS
    run(position=LOT, avg=ENTRY, state=st)
    check("30 bars at 11:00 → exits on the time limit", len(exits()) == 1, PLACED)
    check("  ...and calls it a time limit, not a square-off",
          any("TIME LIMIT" in c for c in CALLS), CALLS[:2])
finally:
    E.LIVE = False

# ── 6. the hourly bot must be untouched ─────────────────────────────────────
print("\n── 6. the hourly bot has no such rules ──")
import executor as H
for name in ("NO_ENTRY_AFTER", "SQUARE_OFF_AT", "past_no_entry_cutoff", "must_square_off"):
    check(f"hourly has no {name}", not hasattr(H, name))
check("the hourly still holds overnight by design (its strategy was tested that way)",
      H.TIMEOUT_BARS == 30)

# ── 7. no OTHER suite may depend on the wall clock ──────────────────────────
# Adding these rules made every existing 5-min test time-dependent overnight:
# green before 15:00, red after. A suite whose result depends on when you run it
# is one you stop believing, so any file that drives this executor must pin the
# clock — and this asserts they do, rather than leaving it to be rediscovered.
print("\n── 7. every suite driving this bot pins the clock ──")
import glob
for path in sorted(glob.glob(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                          "test_*.py"))):
    name = os.path.basename(path)
    if name == os.path.basename(__file__):
        continue                       # this file drives the clock on purpose
    src = open(path).read()
    if "import executor_5m" not in src:
        continue
    pinned = "past_no_entry_cutoff = lambda" in src and "must_square_off = lambda" in src
    check(f"{name} pins the clock", pinned,
          "it drives executor_5m but leaves the time rules on the wall clock")

print(f"\n  {passed} passed, {failed} failed")
sys.exit(1 if failed else 0)
