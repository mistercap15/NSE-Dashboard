#!/usr/bin/env python3
"""The shared contract claim: priority, preemption, and the asymmetric failure.

The race this closes is two bots deciding to enter on the same tick, each having
just read "the other one is clear". coordination.py cannot see that — both reads
were correct at the moment they happened. Only a claim both bots pass through
can.

The concurrency section deliberately uses real forked PROCESSES rather than
threads. The mechanism is an flock, which the kernel arbitrates per file
description; threads in one process would share it and prove nothing about the
case that actually matters, which is two systemd units racing.
"""
import json
import os
import sys
import tempfile
import time

sys.path.insert(0, "/Users/khilanpatel/Desktop/Live Projects/nifty-executor")

import contract_lock as L

passed = failed = 0


def check(label, cond, detail=""):
    global passed, failed
    if cond:
        passed += 1
        print(f"  ok   {label}")
    else:
        failed += 1
        print(f"  FAIL {label}  {detail}")


KEY = "NSE_FO|68407"


def fresh():
    d = tempfile.mkdtemp()
    return os.path.join(d, "nifty.lock")


# ── basics ───────────────────────────────────────────────────────────────────
print("\n── taking and releasing ──")

p = fresh()
check("a free contract is granted", L.claim(p, "5m", KEY)[0])
check("  ...and the claim is readable", (L.read_claim(p) or {}).get("owner") == "5m")
check("re-claiming our own is a refresh, not a refusal", L.claim(p, "5m", KEY)[0])
check("release by the owner succeeds", L.release(p, "5m"))
check("  ...and the contract is free again", L.read_claim(p) is None)
check("release when nothing is held is harmless", L.release(p, "5m"))


# ── priority ─────────────────────────────────────────────────────────────────
print("\n── priority: the hourly outranks the 5-min ──")

# NO PREEMPTION, EVEN OF A MERE RESTING ENTRY. The first design preempted here
# so the hourly always won, and test_entry_race.py then showed BOTH bots placing
# an entry in 60 of 60 races: taking the claim does not take back the order the
# other bot already put on the exchange, and that order only comes off at its
# next poll up to 15s later. Correctness beat priority.
p = fresh()
L.claim(p, "5m", KEY)                       # 5-min has an entry resting
granted, blocker = L.claim(p, "hourly", KEY)
check("hourly does NOT preempt a live 5-min claim — it waits", not granted, blocker)
check("  ...and the claim is still the 5-min's", (L.read_claim(p) or {}).get("owner") == "5m")
check("  ...but it is told who is in the way", (blocker or {}).get("owner") == "5m", blocker)

p = fresh()
L.claim(p, "5m", KEY, holding=True)         # 5-min is actually FILLED
granted, blocker = L.claim(p, "hourly", KEY)
check("hourly WAITS for a filled 5-min position", not granted, blocker)
check("  ...and is told who is in the way",
      (blocker or {}).get("owner") == "5m" and blocker.get("holding") is True, blocker)
check("  ...describe() says it in words",
      "5-min" in L.describe(blocker) and "filled" in L.describe(blocker), L.describe(blocker))

p = fresh()
L.claim(p, "hourly", KEY)
granted, blocker = L.claim(p, "5m", KEY)
check("nor does the 5-min preempt the hourly — symmetric", not granted, blocker)
granted, _ = L.claim(p, "5m", KEY, holding=True)
check("  ...not even claiming to hold", not granted)


# ── the preempted bot must not clobber the winner ────────────────────────────
print("\n── release is owner-guarded ──")

# Nothing can be preempted any more, so the guard is checked directly: a bot
# that does not hold the claim cannot delete it.
p = fresh()
L.claim(p, "hourly", KEY)
check("a bot that does not hold the claim cannot release it", not L.release(p, "5m"))
check("  ...the hourly still holds it", (L.read_claim(p) or {}).get("owner") == "hourly")
check("the hourly can release its own", L.release(p, "hourly"))
check("  ...and the contract is then free", L.read_claim(p) is None)


# ── staleness ────────────────────────────────────────────────────────────────
print("\n── an abandoned claim does not hold the contract for ever ──")

# A claim for a mere ORDER, not a position. This is the one the short clock is
# for: if the bot has not refreshed it in 300s during a session, it is gone.
# (A HOLDING claim is deliberately NOT expired this way — see the overnight
# section below, which is where that distinction came from.)
p = fresh()
L.claim(p, "5m", KEY, holding=False)
rec = L.read_claim(p)
rec["at"] = time.time() - (L.CLAIM_STALE_S + 60)
with open(p, "w") as fh:
    json.dump(rec, fh)
check("a stale order claim is recognised", L.is_stale(L.read_claim(p)))
granted, _ = L.claim(p, "hourly", KEY)
check("  ...and can be taken over", granted)

# And a holding claim IS taken over once the position behind it is gone.
p = fresh()
L.claim(p, "5m", KEY, holding=True)
rec = L.read_claim(p); rec["at"] = time.time() - (L.CLAIM_STALE_S + 60)
with open(p, "w") as fh:
    json.dump(rec, fh)
granted, _ = L.claim(p, "hourly", KEY, position_open=False)
check("  ...as is an OLD holding claim whose position no longer exists", granted)
check("a fresh claim is not stale", not L.is_stale(L.read_claim(p)))
check("a missing claim counts as stale", L.is_stale(None))
check("a claim with a junk timestamp counts as stale", L.is_stale({"owner": "5m", "at": "soon"}))


# ── THE OVERNIGHT CASE, from 8 Sep 2026 ──────────────────────────────────────
# The 5-min bot filled at 15:14 and stopped polling at 15:30, so it stopped
# refreshing its claim. By that evening the claim was four hours old — "stale"
# by the clock — while the position it named was genuinely still open and
# carrying overnight. Worse, the two other guards are at their weakest exactly
# then: the order book is purged overnight so tag attribution is gone by
# morning, leaving only the peer state file. A holding claim must not expire on
# a clock.
print("\n── an overnight HOLDING claim survives, because the position does ──")

p = fresh()
L.claim(p, "5m", KEY, holding=True)
rec = L.read_claim(p)
rec["at"] = time.time() - 4 * 3600          # filled at 15:14, now 19:30
with open(p, "w") as fh:
    json.dump(rec, fh)

check("4h old and holding: NOT stale while the position is open",
      not L.is_stale(L.read_claim(p), position_open=True))
granted, blocker = L.claim(p, "hourly", KEY, position_open=True)
check("  ...so the hourly CANNOT take it at the next open", not granted, blocker)
check("  ...and is told the 5-min holds a filled position",
      "filled" in L.describe(blocker), L.describe(blocker))

# The claim above is 4h old, so a flat account means the trade closed while the
# bot was not watching and the claim is a leftover.
check("once the position is gone AND the claim is old, it is stale",
      L.is_stale(L.read_claim(p), position_open=False))
granted, _ = L.claim(p, "hourly", KEY, position_open=False)
check("  ...and the hourly may take the contract", granted)

# But NOT in the seconds after a fill, when Upstox has not shown the position
# yet. Expiring it there is how you open on top of a position about to appear.
p2 = fresh()
L.claim(p2, "5m", KEY, holding=True)                 # fresh
check("a FRESH holding claim survives a flat-looking account (fill lag)",
      not L.is_stale(L.read_claim(p2), position_open=False))
granted, _ = L.claim(p2, "hourly", KEY, position_open=False)
check("  ...so the hourly still cannot take it", not granted)

# Without the hint at all, a holding claim still gets a long horizon rather than
# the 5-minute one — a caller that cannot see the exchange must not expire it.
p = fresh()
L.claim(p, "5m", KEY, holding=True)
rec = L.read_claim(p); rec["at"] = time.time() - 4 * 3600
with open(p, "w") as fh:
    json.dump(rec, fh)
check("no hint: a 4h-old HOLDING claim is still honoured",
      not L.is_stale(L.read_claim(p)))
rec["at"] = time.time() - (L.HOLDING_STALE_S + 3600)
with open(p, "w") as fh:
    json.dump(rec, fh)
check("  ...but one older than the holding horizon is not",
      L.is_stale(L.read_claim(p)))

# A claim that is NOT holding still expires on the short clock — it represents
# an order, and an unrefreshed order claim means the bot is gone.
p = fresh()
L.claim(p, "5m", KEY, holding=False)
rec = L.read_claim(p); rec["at"] = time.time() - (L.CLAIM_STALE_S + 60)
with open(p, "w") as fh:
    json.dump(rec, fh)
check("a non-holding claim still expires on the short clock",
      L.is_stale(L.read_claim(p), position_open=True))


# ── different contract ───────────────────────────────────────────────────────
print("\n── a claim on another contract is not a claim on this one ──")

p = fresh()
L.claim(p, "hourly", "NSE_FO|OTHER", holding=True)
granted, _ = L.claim(p, "5m", KEY)
check("5-min may claim a different contract", granted)


# ── THE ASYMMETRY ────────────────────────────────────────────────────────────
print("\n── asymmetric failure: hourly fails OPEN, 5-min fails CLOSED ──")

# A path that cannot be created at all — the lock machinery is broken.
broken = "/proc/definitely/not/writable/nifty.lock"
granted_h, _ = L.claim(broken, "hourly", KEY, fail_open=True)
granted_5, _ = L.claim(broken, "5m", KEY, fail_open=False)
check("hourly is GRANTED when the lock is unusable (never disrupted)", granted_h)
check("5-min is REFUSED when the lock is unusable (never trades blind)", not granted_5)
check("read_claim on a broken path returns None rather than raising",
      L.read_claim(broken) is None)
check("release on a broken path returns False rather than raising",
      L.release(broken, "hourly") is False)

# A corrupt claim file is not a claim.
p = fresh()
open(p, "w").write("{not json")
check("a corrupt claim file reads as nobody holding it", L.read_claim(p) is None)
check("  ...and can be claimed over", L.claim(p, "5m", KEY)[0])


# ── CONCURRENCY: real processes, real flock ──────────────────────────────────
print("\n── two processes racing for the same free contract ──")

p = fresh()
N = 24
readpipe, writepipe = os.pipe()
kids = []
for i in range(N):
    pid = os.fork()
    if pid == 0:
        os.close(readpipe)
        # Everyone tries at the same moment. Both bots are represented so the
        # race is the real one, not two copies of the junior bot.
        owner = "hourly" if i % 2 else "5m"
        target = time.time() + 0.35
        while time.time() < target:
            pass                                    # spin, not sleep — tighter start
        got, _ = L.claim(p, owner, KEY, holding=True)
        os.write(writepipe, f"{owner}:{int(got)}\n".encode())
        os._exit(0)
    kids.append(pid)
os.close(writepipe)
out = b""
while True:
    chunk = os.read(readpipe, 4096)
    if not chunk:
        break
    out += chunk
os.close(readpipe)
for pid in kids:
    os.waitpid(pid, 0)

results = [l.split(":") for l in out.decode().split() if l]
grants = [o for o, g in results if g == "1"]
final = L.read_claim(p)

check(f"all {N} processes answered", len(results) == N, len(results))
check("the claim file is intact and owned by exactly one bot",
      final is not None and final.get("owner") in ("hourly", "5m"), final)
# Every 5-min grant must have happened before a hourly claim existed; once the
# hourly holds a FILLED claim no 5-min may be granted, and vice versa. The
# property that must hold at the end is a single coherent owner, never a torn
# or absent record.
check("no process crashed or wrote a torn record",
      final is not None and set(final) >= {"owner", "instrument", "holding", "at"}, final)
check("at least one process was granted", grants, results)
# The 5-min can only win the race outright; it can never take it from a holding
# hourly. So if the hourly ever held it, the final owner must be the hourly.
check("a holding hourly claim is never taken by the 5-min",
      not (any(o == "hourly" for o in grants) and final.get("owner") == "5m"),
      (grants, final))

print(f"\n  {passed} passed, {failed} failed")
sys.exit(1 if failed else 0)
