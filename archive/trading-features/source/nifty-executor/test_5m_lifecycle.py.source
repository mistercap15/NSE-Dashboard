#!/usr/bin/env python3
"""The 5-minute gap-fill bot: lifecycle, and the coordination that keeps it
out of the hourly bot's way.

  python3 test_5m_lifecycle.py

Two halves, and the second is the one that matters.

PART 1 runs the real reconcile() in dry mode and reads its intentions, the same
way test_executor_lifecycle.py does for the hourly bot.

PART 2 runs it with LIVE = True and stubbed order placers, and asserts on the
ARGUMENTS handed to those placers. That distinction is not pedantry: in dry mode
act() only ANNOUNCES, it never calls the function, so a test that asserts on
message text proves nothing about whether an order would have been placed. A
coordination bug that let a real order through would sail past a dry-mode test
saying "intends no order" — because in dry mode nothing is ever placed anyway.

The invariant under test, stated once: at no point may this bot place an entry
while the hourly bot holds a position, has one armed, or cannot be read.
"""
import json
import os
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone

TMP = tempfile.mkdtemp()
HOURLY_STATE = os.path.join(TMP, "executor_state.json")
os.environ["EXECUTOR_5M_STATE"] = os.path.join(TMP, "executor_5m_state.json")
os.environ["HOURLY_STATE"] = HOURLY_STATE
os.environ["PEER_STATE"] = os.path.join(TMP, "ib_state.json")
# A writable claim path. Without this the default /root/... is unreachable on a
# dev box and the bot correctly FAILS CLOSED — which is right, but would make
# every test below assert on that rather than on the behaviour under test.
LOCK = os.path.join(TMP, "nifty_contract.lock")
os.environ["CONTRACT_LOCK"] = LOCK
os.environ.setdefault("APP_PIN", "test")

sys.path.insert(0, "/Users/khilanpatel/Desktop/Live Projects/nifty-executor")

import executor_5m as E
import contract_lock as lock
import coordination as coord
import upstox_orders as ux

# ── PIN THE CLOCK ────────────────────────────────────────────────────────────
# The 5-min bot is now intraday: it opens nothing after 15:00 and squares off at
# 15:20. Every assertion below is about MID-SESSION behaviour, so without this
# the suite passes in the morning and fails after 15:00 — a suite whose result
# depends on when you run it is one you stop believing. test_5m_intraday.py owns
# the time-based rules and drives the clock deliberately.
E.past_no_entry_cutoff = lambda now=None: False
E.must_square_off = lambda now=None: False


IST = timezone(timedelta(hours=5, minutes=30))
KEY = "NSE_FO|58072"
LOT = 65
ENTRY, STOP, TARGET = 24220.0, 24134.0, 24436.0

CALLS: list = []
PLACED: list = []
passed = failed = 0


def check(label, cond, detail=""):
    global passed, failed
    if cond:
        passed += 1
        print(f"  ✓ PASS    {label}")
    else:
        failed += 1
        print(f"  ✗ FAIL    {label}  {detail}")


E.tg = lambda text: CALLS.append(text)
for _name in ("place_limit_buy", "place_limit_sell", "place_sl_m", "place_sl",
              "cancel_order", "modify_order"):
    def _make(n):
        def f(*a, **k):
            PLACED.append((n, a, k))
            return f"ORDER-{n}"
        return f
    setattr(ux, _name, _make(_name))


def intended():
    return [c for c in CALLS if c.startswith("WOULD")]


def said(*fragments):
    return any(all(f.lower() in c.lower() for f in fragments) for c in CALLS)


# ── The hourly bot's state file, which this bot reads and never writes ───────

def hourly(**fields):
    """Write the hourly's state file. Fresh mtime, so it is never stale."""
    with open(HOURLY_STATE, "w") as fh:
        json.dump(fields, fh)


def hourly_gone():
    try:
        os.remove(HOURLY_STATE)
    except OSError:
        pass


def hourly_stale():
    hourly()
    old = time.time() - (coord.STATE_MAX_AGE_S + 60)
    os.utime(HOURLY_STATE, (old, old))


# ── Scripted world ──────────────────────────────────────────────────────────

def order(tag, price=ENTRY, oid="OLD-1", status="open"):
    return {"instrument_token": KEY, "tag": tag, "order_id": oid,
            "price": price, "status": status}


def payload(*, armed=True, entry=ENTRY, stop=STOP, target=TARGET,
            dte=30.0, as_of="bar-01", token_valid=True, signal=True):
    expiry = int((datetime.now(tz=IST) + timedelta(days=dte)).timestamp() * 1000)
    return {
        "tokenValid": token_valid,
        "error": None if token_valid else "Upstox not connected",
        "contract": {"instrumentKey": KEY, "lotSize": LOT, "tickSize": 10,
                     "tradingSymbol": "NIFTY FUT 29 SEP 26", "expiry": expiry},
        "signal": ({"entryValid": armed, "fibEntry": entry, "stopPrice": stop,
                    "targetPrice": target, "asOf": as_of} if signal else None),
    }


def world(position=0, avg=None, book=None, owned=True):
    book = list(book or [])
    if position and owned and not any((o.get("tag") or "") == E.TAG_ENTRY
                                      and (o.get("status") or "") == "complete" for o in book):
        book.append({"instrument_token": KEY, "status": "complete", "tag": E.TAG_ENTRY,
                     "order_id": "FILLED-ENTRY", "price": avg, "average_price": avg})
    ux.get_positions = lambda t: ([{"instrument_token": KEY, "quantity": position,
                                    "average_price": avg}] if position else [])
    ux.get_order_book = lambda t: list(book)
    ux.get_quote = lambda t, k: {"depth": {"buy": [{"price": 24150.0}]}, "last_price": 24450.0}


def free_contract():
    try:
        os.remove(LOCK)
    except OSError:
        pass


def run(position=0, avg=None, book=None, state=None, owned=True, **kw):
    CALLS.clear()
    PLACED.clear()
    world(position, avg, book, owned)
    st = state if state is not None else {}
    E.reconcile("tok", payload(**kw), st)
    return st


def entries_placed():
    """Real calls that would OPEN a position. The only thing the invariant is about."""
    return [p for p in PLACED if p[0] == "place_limit_buy"]


print("═" * 74)
print("  5-minute gap-fill bot — lifecycle and coordination")
print(f"  LIVE = {E.LIVE}   ({'places nothing' if not E.LIVE else 'DANGER'})")
print(f"  hourly state read from {HOURLY_STATE}")
print("═" * 74)
if E.LIVE:
    print("\nRefusing to run: LIVE must default to False.")
    sys.exit(1)


# ════ PART 1 — dry-mode lifecycle ════════════════════════════════════════════
print("\n\n── PART 1: lifecycle, hourly idle throughout ──")

hourly()                                    # idle and fresh
run(armed=False)
check("signal not armed → intends nothing", not intended(), intended())

run()
check("armed + hourly idle → intends to place the buy order",
      any("place BUY order" in c for c in intended()), intended())

st = run(position=LOT, avg=ENTRY, state={})
check("filled → intends a stop-loss", any("STOP-LOSS" in c for c in intended()), intended())
check("filled → intends a target", any("TARGET" in c for c in intended()), intended())
check("filled → announces the trade is open", said("TRADE OPEN"), CALLS[:2])

check("state records the contract", st.get("instrument") == KEY, st)
check("stop is anchored to the signal, not the fill", st.get("stop") == STOP, st)


# ════ PART 2 — coordination, DRY ═════════════════════════════════════════════
print("\n\n── PART 2: the hourly goes active ──")

print("\n  [hourly ARMED, 5-min flat]")
hourly(armed={"entry": 24500}, instrument=KEY)
run()
check("does NOT intend to open", not any("place BUY order" in c for c in intended()), intended())
check("says it is standing down", said("standing down"), CALLS[:1])
check("names the hourly bot", said("hourly"), CALLS[:1])

print("\n  [hourly HOLDING, 5-min flat]")
hourly(entry_bar="2026-09-05T10:15:00+05:30", instrument=KEY)
run()
check("does NOT intend to open", not any("place BUY order" in c for c in intended()), intended())

print("\n  [hourly ARMED while our entry is resting → we withdraw it]")
hourly(armed={"entry": 24500}, instrument=KEY)
run(book=[order(E.TAG_ENTRY, oid="OURS-1")])
check("intends to CANCEL our resting buy order",
      any("cancel our buy order" in c.lower() for c in intended()), intended())
check("still does not intend to open", not any("place BUY order" in c for c in intended()))

print("\n  [hourly ARMED while the 5-min HOLDS a position]")
hourly(armed={"entry": 24500}, instrument=KEY)
st = run(position=LOT, avg=ENTRY, state={"entry_bar": "b1", "instrument": KEY,
                                         "stop": STOP, "target": TARGET, "bars": 1})
check("does NOT add to the position", not any("place BUY order" in c for c in intended()), intended())
check("says it is managing what it holds", said("managing the trade already open"), CALLS[:1])

print("\n  [hourly's entry resting on the exchange, state file silent]")
hourly()                                    # state says idle …
run(book=[{"instrument_token": KEY, "tag": "fibentry", "status": "open",
           "order_id": "HOURLY-1", "price": 24500}])
check("the ORDER BOOK alone stops it opening",
      not any("place BUY order" in c for c in intended()), intended())

print("\n  [a position on the contract that is not ours]")
hourly()
run(position=LOT, avg=ENTRY, book=[], owned=False)
check("does not open, and does not adopt", not any("place BUY order" in c for c in intended()))

print("\n  [hourly state missing / stale — fail safe]")
hourly_gone()
run()
check("missing hourly state → does not open",
      not any("place BUY order" in c for c in intended()), intended())
check("  ...and says why", said("could not be read") or said("standing down"), CALLS[:1])
hourly_stale()
run()
check("stale hourly state → does not open",
      not any("place BUY order" in c for c in intended()), intended())
check("  ...and names staleness", said("stale") or said("not been updated"), CALLS[:1])

print("\n  [hourly clears again]")
# A DIFFERENT entry price on purpose. In dry mode act() announces through
# tg_once, which suppresses an IDENTICAL string — and the same intent was
# already announced earlier in this run. Re-using 24220 here would assert on
# the dedupe rather than on the bot, and would "fail" while the bot was
# behaving perfectly. Part 3 checks resumption again in LIVE mode, where every
# call is reported.
hourly()
run(entry=24225.0)
check("hourly idle again → free to trade",
      any("place BUY order" in c for c in intended()), intended())
check("  ...and announces the hourly is clear",
      said("hourly bot is clear"), CALLS[:2])


# ════ PART 3 — THE INVARIANT, IN LIVE MODE, ON REAL ARGUMENTS ════════════════
# Dry mode never calls the placer, so every assertion above is about text. This
# part flips LIVE on with the placers stubbed, so "no entry was placed" is a
# statement about the function that would have sent the order.
print("\n\n── PART 3: LIVE mode — asserting on the calls themselves ──")

E.LIVE = True
try:
    print("\n  [hourly idle]")
    hourly()
    run()
    check("hourly idle → an entry IS actually placed", len(entries_placed()) == 1, PLACED)
    if entries_placed():
        _n, args, _k = entries_placed()[0]
        check("  ...for the right contract and quantity",
              args[1] == KEY and args[2] == LOT * E.QUANTITY_LOTS, args)
        check("  ...at the fib entry price", args[3] == E.ux.round_to_tick(ENTRY, 10), args)

    for label, fields in [
        ("hourly ARMED",            dict(armed={"entry": 24500}, instrument=KEY)),
        ("hourly HOLDING",          dict(entry_bar="b", instrument=KEY)),
        ("hourly has a fill",       dict(entry_fill={"price": 24500}, instrument=KEY)),
    ]:
        print(f"\n  [{label}]")
        hourly(**fields)
        run()
        check(f"{label} → NO entry order is placed", not entries_placed(), PLACED)

    print("\n  [hourly state unreadable]")
    hourly_gone()
    run()
    check("unreadable → NO entry order is placed", not entries_placed(), PLACED)

    print("\n  [hourly state stale]")
    hourly_stale()
    run()
    check("stale → NO entry order is placed", not entries_placed(), PLACED)

    print("\n  [hourly's order resting on the book only]")
    hourly()
    run(book=[{"instrument_token": KEY, "tag": "fibentry", "status": "open",
               "order_id": "H-1", "price": 24500}])
    check("book evidence → NO entry order is placed", not entries_placed(), PLACED)

    print("\n  [our resting entry is really cancelled when we yield]")
    hourly(armed={"entry": 24500}, instrument=KEY)
    run(book=[order(E.TAG_ENTRY, oid="OURS-9")])
    cancels = [p for p in PLACED if p[0] == "cancel_order"]
    check("cancel_order called with OUR order id",
          any("OURS-9" in str(p[1]) for p in cancels), cancels)
    check("  ...and no entry placed in the same poll", not entries_placed(), PLACED)

    # ── the sweep ────────────────────────────────────────────────────────────
    print("\n  [exhaustive: every way the hourly can show life]")
    violations = []
    hourly_variants = [
        ("armed",      dict(armed={"entry": 24500}, instrument=KEY)),
        ("holding",    dict(entry_bar="b", instrument=KEY)),
        ("fill",       dict(entry_fill={"price": 1}, instrument=KEY)),
    ]
    books = [
        ("clean", []),
        ("hourly entry resting", [{"instrument_token": KEY, "tag": "fibentry",
                                   "status": "open", "order_id": "H"}]),
        ("hourly stop resting", [{"instrument_token": KEY, "tag": "fibstop",
                                  "status": "open", "order_id": "H"}]),
    ]
    for hname, hf in hourly_variants:
        for bname, bk in books:
            hourly(**hf)
            run(book=list(bk))
            if entries_placed():
                violations.append((hname, bname))
    check(f"no combination of hourly activity produced an entry "
          f"({len(hourly_variants) * len(books)} combinations)",
          not violations, violations)
finally:
    E.LIVE = False

check("LIVE was restored to False after the live-mode section", E.LIVE is False)

# ════ PART 4 — ISOLATION: the hourly bot must be untouchable ════════════════
# The brief's hard requirement. Everything this bot owns must be a different
# file, a different tag and a different switch from the hourly's, and no amount
# of running it may alter the hourly's state.
print("\n\n── PART 4: isolation from the hourly bot ──")

import executor as H          # the real hourly module, default paths

check("state files are different",
      os.path.abspath(E.STATE_PATH) != os.path.abspath(H.STATE_PATH),
      (E.STATE_PATH, H.STATE_PATH))
check("kill switches are different files",
      os.path.abspath(E.SWITCH_PATH) != os.path.abspath(H.SWITCH_PATH),
      (E.SWITCH_PATH, H.SWITCH_PATH))
check("order tags are disjoint",
      not (set(E.OUR_TAGS) & set(H.OUR_TAGS)), (E.OUR_TAGS, H.OUR_TAGS))
check("this bot reads the hourly's state as its peer",
      os.path.abspath(E.HOURLY_STATE) == os.path.abspath(HOURLY_STATE), E.HOURLY_STATE)
check("Telegram messages are prefixed so the two bots are distinguishable",
      E.PREFIX.strip() == "[5M]", E.PREFIX)

# Nothing in this module may write the hourly's file. Proven by fingerprinting
# it and driving a full spread of polls — armed, holding, yielding, stale —
# rather than by reading the source and hoping.
hourly(entry_bar="HOURLY-OWNS-THIS", instrument=KEY, entry_price=24111.0)
before_bytes = open(HOURLY_STATE, "rb").read()
before_mtime = os.path.getmtime(HOURLY_STATE)

for kw in ({}, {"armed": False}, {"dte": 1.0}, {"token_valid": False}, {"signal": False}):
    try:
        run(**kw)
        run(position=LOT, avg=ENTRY, state={"entry_bar": "b", "instrument": KEY}, **kw)
    except Exception:
        pass                      # a throw is a separate concern; isolation is not
check("the hourly's state file is byte-identical after 10 polls",
      open(HOURLY_STATE, "rb").read() == before_bytes)
check("  ...and its mtime was never touched",
      os.path.getmtime(HOURLY_STATE) == before_mtime)

# The hourly's own view of the world must be unchanged by any of that.
check("the hourly still reads its own state correctly",
      json.loads(before_bytes).get("entry_bar") == "HOURLY-OWNS-THIS")

# And the source itself: no write path to the hourly's file.
src = open("executor_5m.py").read()
writes = [ln.strip() for ln in src.splitlines()
          if "HOURLY_STATE" in ln and ("open(" in ln or "json.dump" in ln or "replace" in ln)]
opens_readonly = all("\"w\"" not in w and "'w'" not in w for w in writes)
check("no write-mode open of the hourly state anywhere in the source",
      opens_readonly, writes)
check("save_state only ever writes this bot's own STATE_PATH",
      "tmp = STATE_PATH + \".tmp\"" in src)

# THE ONE THAT ACTUALLY BIT. Sharing the hourly's Telegram token and long-polling
# getUpdates made Telegram return 409 Conflict to both bots — this one was
# stealing the hourly's /stop, /start and /status. Measured on the droplet: the
# hourly logged 0 conflicts in two days, then 28 in twenty minutes.
check("no own Telegram token → the command listener is DISABLED",
      E.OWN_TELEGRAM_BOT is False, E.OWN_TELEGRAM_BOT)
check("  ...but it can still SEND on the shared token (sending does not conflict)",
      bool(E.TELEGRAM_TOKEN) == bool(os.environ.get("TELEGRAM_BOT_TOKEN", "")))
check("  ...and main() only starts the listener behind that flag",
      "if OWN_TELEGRAM_BOT:" in src and "threading.Thread(target=telegram_listener" in src)
check("  ...and the boot message says commands are off",
      "Commands are OFF for this bot" in src)

os.environ["TELEGRAM_BOT_TOKEN_5M"] = "1234:its-own-bot"
for _m in ("executor_5m",):
    sys.modules.pop(_m, None)
import executor_5m as E2
check("given its OWN token → the listener is enabled again",
      E2.OWN_TELEGRAM_BOT is True and E2.TELEGRAM_TOKEN == "1234:its-own-bot",
      (E2.OWN_TELEGRAM_BOT, E2.TELEGRAM_TOKEN[:8]))
del os.environ["TELEGRAM_BOT_TOKEN_5M"]

# ════ PART 5 — THE SHARED CLAIM ══════════════════════════════════════════════
# The three-source check cannot see two bots deciding on the SAME tick — both
# reads were correct when they happened. These assert the claim closes it.
print("\n\n── PART 5: the shared contract claim ──")

E.LIVE = True
try:
    print("\n  [the hourly holds the claim]")
    free_contract()
    lock.claim(LOCK, "hourly", KEY, holding=False)
    hourly()                                  # state file says idle …
    run()
    check("claim held by the hourly → NO entry placed even though state reads idle",
          not entries_placed(), PLACED)
    check("  ...and it says who holds the contract", said("hourly bot"), CALLS[:1])

    print("\n  [the claim is free again]")
    free_contract()
    hourly()
    run(entry=24231.0)
    check("claim free → an entry IS placed", len(entries_placed()) == 1, PLACED)
    check("  ...and this bot now holds the claim",
          (lock.read_claim(LOCK) or {}).get("owner") == "5m", lock.read_claim(LOCK))

    print("\n  [we hold a filled position → the claim says holding]")
    free_contract()
    hourly()
    run(position=LOT, avg=ENTRY, state={"entry_bar": "b", "instrument": KEY,
                                        "stop": STOP, "target": TARGET, "bars": 1})
    rec = lock.read_claim(LOCK) or {}
    check("claim marked holding=True so the hourly must wait",
          rec.get("owner") == "5m" and rec.get("holding") is True, rec)
    granted, blocker = lock.claim(LOCK, "hourly", KEY, holding=False, fail_open=True)
    check("  ...and the hourly is indeed refused", not granted, blocker)

    print("\n  [flat with no setup → the contract is released]")
    free_contract()
    lock.claim(LOCK, "5m", KEY)
    hourly()
    run(armed=False)
    check("released when there is nothing to do",
          lock.read_claim(LOCK) is None, lock.read_claim(LOCK))

    print("\n  [an unusable claim path → fail CLOSED]")
    E.LOCK_PATH = "/proc/nope/nifty.lock"
    hourly()
    run(entry=24239.0)
    check("unusable claim → NO entry placed", not entries_placed(), PLACED)
    check("  ...and it says it is failing closed",
          said("failing closed") or said("standing down"), CALLS[:1])
    E.LOCK_PATH = LOCK
finally:
    E.LIVE = False
free_contract()

print(f"\n  {passed} passed, {failed} failed")
sys.exit(1 if failed else 0)
