# /root/fib-bot/executor_5m.env  — the 5-minute gap-fill bot.
#
# Separate from executor.env on purpose: nothing here can affect the hourly bot.
# Copy to /root/fib-bot/executor_5m.env on the droplet and fill in.

# DRY BY DEFAULT. Leave unset (or "false") to place no real orders. Only set
# this to true after watching the coordination stand-down messages behave.
FIB5M_LIVE=false

SIGNAL_URL_5M=https://nse-dashboard-gamma.vercel.app/api/fib-5m/signal
APP_PIN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TOKEN_PATH=/root/fib-bot/.upstox_token

# This bot's own files.
EXECUTOR_5M_STATE=/root/fib-bot/executor_5m_state.json

# READ-ONLY. The hourly bot's state — the coordination layer's first source of
# truth. This bot never writes it.
HOURLY_STATE=/root/fib-bot/executor_state.json
PEER_STATE=/root/fib-bot/ib_state.json
