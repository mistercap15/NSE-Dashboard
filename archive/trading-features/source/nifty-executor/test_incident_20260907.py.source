#!/usr/bin/env python3
"""The 7 Sep 2026 incident, reproduced and asserted fixed.

WHAT HAPPENED, from the order book and both state files:

  14:40:04  the 5-min bot's entry filled — f5entry BUY 65 @ 23884.9. It claimed
            the contract with holding=true. All correct.
  14:40:3x  the HOURLY bot saw 65 lots it had not bought. It scanned the order
            book for a tag it recognised and found none, because its private
            owner map listed only fibentry/ibentryl/ibentrys — "f5entry" was
            never added when the 5-min bot was built. Concluding the position
            belonged to nobody, it ADOPTED it: wrote the 5-min's fill price
            23884.9 into its own state and began placing ITS bracket (stop
            23910.54, target 24296.1) on the 5-min's lots.
  then      both bots held brackets on the same 65. The account went over
            margin. Every order came back "You need to add Rs 128,240.44".
            A rejected order is never RESTING, so the next poll saw no bracket
            and sent it again — 50 rejected orders in eleven minutes.
  /stop     did nothing, because /stop means "open nothing new" and
            deliberately keeps protecting an open position. It was working as
            documented. There was no command that meant "place NOTHING".

Four faults, four fixes, all asserted below:

  1. attribution ran off a private map that had to be edited in two places
  2. adoption never consulted the claim, which was correct the whole time
  3. a rejected order was retried for ever
  4. there was no hard stop
"""
import json
import os
import sys
import tempfile
from datetime import datetime, timedelta, timezone

TMP = tempfile.mkdtemp()
HOURLY_STATE = os.path.join(TMP, "executor_state.json")
FIVE_STATE = os.path.join(TMP, "executor_5m_state.json")
LOCK = os.path.join(TMP, "nifty_contract.lock")
os.environ.update({
    "EXECUTOR_STATE": HOURLY_STATE, "PEER_STATE": os.path.join(TMP, "ib.json"),
    "PEER_STATE_5M": FIVE_STATE, "CONTRACT_LOCK": LOCK,
    "APP_PIN": "test", "SIGNAL_URL": "http://localhost/api/fib/signal",
})

sys.path.insert(0, "/Users/khilanpatel/Desktop/Live Projects/nifty-executor")

import contract_lock as lock
import coordination as coord
import executor as H
import upstox_orders as ux

IST = timezone(timedelta(hours=5, minutes=30))
KEY = "NSE_FO|68407"
LOT = 65
FILL = 23884.9                      # the 5-min bot's actual fill that day

CALLS: list = []
PLACED: list = []
passed = failed = 0


def check(label, cond, detail=""):
    global passed, failed
    if cond:
        passed += 1
        print(f"  ok   {label}")
    else:
        failed += 1
        print(f"  FAIL {label}   {detail}")


H.tg = lambda t: CALLS.append(t)
for _n in ("place_limit_buy", "place_limit_sell", "place_sl_m", "place_sl",
           "cancel_order", "modify_order"):
    def _mk(n):
        def f(*a, **k):
            PLACED.append((n, a, k))
            return f"OID-{n}"
        return f
    setattr(ux, _n, _mk(_n))


def payload(armed=True):
    expiry = int((datetime.now(tz=IST) + timedelta(days=22)).timestamp() * 1000)
    return {"tokenValid": True, "error": None,
            "contract": {"instrumentKey": KEY, "lotSize": LOT, "tickSize": 10,
                         "tradingSymbol": "NIFTY FUT 29 SEP 26", "expiry": expiry},
            "signal": {"entryValid": armed, "fibEntry": 23980.0, "stopPrice": 23910.54,
                       "targetPrice": 24296.1, "asOf": "2026-09-07T13:15:00+05:30"}}


def world(position=0, avg=None, book=None):
    ux.get_positions = lambda t: ([{"instrument_token": KEY, "quantity": position,
                                    "average_price": avg}] if position else [])
    ux.get_order_book = lambda t: list(book or [])
    # Bid ABOVE the 23910.54 stop — see the note in test_executor.py. These
    # tests are about attribution and the circuit breaker, not about gaps.
    ux.get_quote = lambda t, k: {"depth": {"buy": [{"price": 23990.0}]}, "last_price": 24000.0}


def run(position=0, avg=None, book=None, state=None, **kw):
    CALLS.clear(); PLACED.clear()
    world(position, avg, book)
    st = state if state is not None else {}
    H.reconcile("tok", payload(**kw), st)
    return st


def of(kind):
    return [p for p in PLACED if p[0] == kind]


def five_min_filled_order(status="complete"):
    """The exact order that confused the hourly bot."""
    return {"instrument_token": KEY, "tag": "f5entry", "status": status,
            "order_id": "260907000190576", "transaction_type": "BUY",
            "quantity": LOT, "price": FILL, "average_price": FILL,
            "order_timestamp": "2026-09-07 14:40:04"}


def rejected(tag, n, msg="You need to add Rs. 128240.44 in your account to place this trade."):
    return [{"instrument_token": KEY, "tag": tag, "status": "rejected",
             "order_id": f"R{i}", "status_message": msg} for i in range(n)]


print("═" * 76)
print("  7 Sep 2026 — the double-adoption incident, asserted fixed")
print("═" * 76)
H.LIVE = True
try:
    # ── FAULT 1: the private owner map ───────────────────────────────────────
    print("\n── 1. attribution knows every bot's tags ──")
    check("the registry knows f5entry", coord.owner_of("f5entry") == "the 5-min bot")
    check("  ...and the hourly's own", coord.owner_of("fibentry") == "the hourly Fib bot")
    check("  ...and the inside-bar's", coord.owner_of("ibentryl") == "the inside-bar bot")
    check("an unknown tag is still unknown", coord.owner_of("whatever") is None)
    # every tag any executor actually uses must be registered
    import executor_5m as F
    # Pin the clock: this file only reads F.OUR_TAGS today, but it imports the
    # executor and the next assertion added here would inherit the 15:00/15:20
    # rules and turn green-or-red on the wall clock.
    F.past_no_entry_cutoff = lambda now=None: False
    F.must_square_off = lambda now=None: False
    for tag in list(H.OUR_TAGS) + list(F.OUR_TAGS):
        check(f"  registered: {tag}", coord.owner_of(tag) is not None, tag)

    # ── THE INCIDENT ITSELF ──────────────────────────────────────────────────
    print("\n── 2. the hourly must NOT adopt the 5-min's position ──")
    lock.claim(LOCK, "5m", KEY, holding=True)
    json.dump({"entry_bar": "2026-09-07T14:35:00+05:30", "instrument": KEY,
               "entry_price": FILL}, open(FIVE_STATE, "w"))
    st = run(position=LOT, avg=FILL, book=[five_min_filled_order()], state={})
    check("it does not adopt", not st.get("entry_bar"), st)
    check("it places NO stop on the other bot's lots", not of("place_sl"), PLACED)
    check("it places NO target either", not of("place_limit_sell"), PLACED)
    check("it names the 5-min bot", any("5-min" in c for c in CALLS), CALLS[:1])
    check("and never writes the other bot's fill price into its state",
          st.get("entry_price") != FILL, st)

    # The order book alone must be enough — no dependence on the 5-min having
    # written its state file yet. That timing gap is what let it through.
    print("\n── 3. ...even in the seconds before the 5-min writes its state ──")
    json.dump({}, open(FIVE_STATE, "w"))
    try:
        os.remove(LOCK)
    except OSError:
        pass
    st = run(position=LOT, avg=FILL, book=[five_min_filled_order()], state={})
    check("the ORDER BOOK alone stops the adoption", not st.get("entry_bar"), st)
    check("  ...and no bracket is placed", not of("place_sl") and not of("place_limit_sell"), PLACED)

    # And the claim alone must be enough, even with an empty book.
    print("\n── 4. ...and the claim alone is enough, with an empty book ──")
    lock.claim(LOCK, "5m", KEY, holding=True)
    json.dump({}, open(FIVE_STATE, "w"))
    st = run(position=LOT, avg=FILL, book=[], state={})
    check("the CLAIM alone stops the adoption", not st.get("entry_bar"), st)
    check("  ...and no bracket is placed", not of("place_sl") and not of("place_limit_sell"), PLACED)

    # A genuinely unattributed position is still adopted — that behaviour is
    # deliberate and must survive the fix.
    print("\n── 5. a genuinely orphaned position is STILL adopted ──")
    try:
        os.remove(LOCK)
    except OSError:
        pass
    json.dump({}, open(FIVE_STATE, "w"))
    st = run(position=LOT, avg=FILL, book=[], state={})
    check("nothing claims it → adopt and protect it", of("place_sl"), PLACED)
    check("  ...and say so", any("TAKING OVER" in c for c in CALLS), CALLS[:1])

    # ── FAULT 3: the retry storm ─────────────────────────────────────────────
    print("\n── 6. a rejected order is not retried for ever ──")
    check("under the limit it still tries",
          not coord.rejected_count([], KEY, "fibstop") >= coord.REJECT_LIMIT)
    book = rejected("fibstop", coord.REJECT_LIMIT) + rejected("fibtarget", coord.REJECT_LIMIT)
    st = run(position=LOT, avg=FILL, book=book, state={})
    check(f"after {coord.REJECT_LIMIT} rejections it stops sending the stop",
          not of("place_sl"), PLACED)
    check("  ...and the target", not of("place_limit_sell"), PLACED)
    check("  ...and says it has given up", any("GIVING UP" in c for c in CALLS), CALLS[:1])
    check("  ...quoting the exchange's own reason",
          any("128240.44" in c for c in CALLS), CALLS[:1])
    # one message, not one per poll
    seen = []
    for _ in range(5):
        run(position=LOT, avg=FILL, book=book, state={"entry_bar": "b", "instrument": KEY,
                                                      "stop": 23910.54, "target": 24296.1})
        seen.extend(CALLS)
    check("five more polls produce ONE more message, not five",
          len([c for c in seen if "GIVING UP" in c]) <= 1,
          len([c for c in seen if "GIVING UP" in c]))

    # ── FAULT 4: no hard stop ────────────────────────────────────────────────
    print("\n── 7. /halt places nothing at all ──")
    H._set_halted(True)
    run(position=LOT, avg=FILL, book=[], state={"entry_bar": "b", "instrument": KEY,
                                                "stop": 23910.54, "target": 24296.1})
    check("halted → no stop", not of("place_sl"), PLACED)
    check("halted → no target", not of("place_limit_sell"), PLACED)
    check("halted → no entry", not of("place_limit_buy"), PLACED)
    check("halted → no cancels either", not of("cancel_order"), PLACED)
    check("it is persisted to disk", H.load_halt() is True)
    check("  ...and the switch file still records enabled separately",
          isinstance(json.load(open(H.SWITCH_PATH)).get("enabled"), bool))
    H._set_halted(False)
    check("/start clears it", H.load_halt() is False)
    run(position=LOT, avg=FILL, book=[], state={})
    check("and after /start it protects again", of("place_sl"), PLACED)

    # ── the /stop wording that misled ────────────────────────────────────────
    print("\n── 8. /stop now points at /halt ──")
    src = open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "executor.py")).read()
    check("the /stop message mentions /halt", "send /halt" in src)
    check("/halt is a real command", 'text.startswith("/halt")' in src)

    # ── the cosmetic one ─────────────────────────────────────────────────────
    print("\n── 9. the 5-min bot no longer double-prefixes ──")
    src5 = open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "executor_5m.py")).read()
    check("PREFIX is applied once, not twice", "text = PREFIX + text" not in src5)
finally:
    H.LIVE = False

print(f"\n  {passed} passed, {failed} failed")
sys.exit(1 if failed else 0)
