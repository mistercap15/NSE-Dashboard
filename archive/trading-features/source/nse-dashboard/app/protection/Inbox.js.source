'use client';
import {useEffect,useState} from 'react';
export default function Inbox({data}){
 const [state,setState]=useState(null),[error,setError]=useState(''),[busy,setBusy]=useState(false);
 async function refresh(){try{const r=await fetch('/api/protection/inbox');const d=await r.json();if(!r.ok)throw Error(d.error);setState(d);setError('');}catch(e){setError(e.message);}}
 useEffect(()=>{refresh();const t=setInterval(refresh,60000);return()=>clearInterval(t);},[]);
 async function act(body){setBusy(true);try{const r=await fetch('/api/protection/inbox',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok)throw Error(d.error);await refresh();}catch(e){setError(e.message);}finally{setBusy(false);}}
 const watch=()=>act({action:'watch',position:{symbol:data.position.symbol,contract:data.position.contractKey,entry:data.position.entry,lots:data.position.lots,expiryDate:data.position.expiryDate}});
 return <section className="mt-6 rounded-2xl border border-border bg-card p-5"><div className="flex justify-between gap-3"><h2 className="font-semibold">Advisory inbox {state?`· ${state.alerts.filter(x=>x.unread).length} unread`:''}</h2><button onClick={refresh} className="text-sm text-accent">Refresh</button></div><p className="mt-2 text-xs text-soft">Only saved watches are monitored while the app is closed. About five-minute polling, not instant alerts. No trades or Telegram messages.</p>{data&&<button disabled={busy||!data.position.contractKey} onClick={watch} className="mt-3 rounded-lg bg-accent px-4 py-2 text-white text-sm disabled:opacity-40">Monitor this futures position</button>}{error&&<p role="alert" className="text-amber text-sm mt-3">{error}</p>}{state&&<p className="mt-2 text-xs text-dim">Worker: {state.health?.error|| (state.health?.last_success?`last cycle ${new Date(Number(state.health.last_success)*1000).toLocaleString()}`:'waiting for first cycle')}</p>}{state&&<details className="mt-4"><summary className="cursor-pointer text-sm">Watched positions & recent alerts</summary>{state.watches.filter(w=>w.enabled).map(w=><div className="mt-3 border-b border-border pb-3 text-sm" key={w.id}><strong>{w.position.symbol} · {w.position.lots} lots</strong><p className="text-xs text-soft">{w.position.expiryDate} · last check {w.last_poll?new Date(w.last_poll*1000).toLocaleString():'Pending'}</p><button disabled={busy} onClick={()=>act({action:'unwatch',id:w.id})} className="text-accent text-xs mt-2">Stop monitoring</button></div>)}{!state.watches.some(w=>w.enabled)&&<p className="mt-3 text-sm text-soft">No active watches. Add your position after calculating.</p>}{state.alerts.map(a=>{let d={};try{d=JSON.parse(a.detail);}catch{}return <article key={a.id} className="mt-4 border-t border-border pt-3"><p className="font-semibold text-sm">{a.unread?'● ':''}{a.title}</p><p className="text-xs text-dim">{new Date(a.at*1000).toLocaleString()}</p>{d.reasons?.map((x,i)=><p key={i} className="mt-1 text-xs text-soft">{x}</p>)}{d.headlines?.map(x=><a className="block text-xs text-accent mt-2" key={x.url} href={x.url} target="_blank" rel="noopener noreferrer">{x.title} · {x.source}</a>)}{d.summary?.exit&&<p className="mt-2 text-xs text-soft">Existing hedge review: {d.summary.exit}</p>}{a.unread===1&&<button disabled={busy} onClick={()=>act({action:'read',id:a.id})} className="text-xs text-accent mt-2">Mark read</button>}</article>;})}</details>}</section>;
}
