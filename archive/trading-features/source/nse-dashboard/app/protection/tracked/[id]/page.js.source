'use client';
import {useEffect,useState} from 'react';
import Link from 'next/link';
import {useRouter} from 'next/navigation';
import LoadingCard from '../../LoadingCard';
import Sidebar from '../../../components/Sidebar';
import ActionCard from '../../ActionCard';
import ProtectionDetails from '../../ProtectionDetails';
export default function Detail({params}){
 const router=useRouter();
 const [alerts,setAlerts]=useState([]),[watch,setWatch]=useState(null),[data,setData]=useState(null),[error,setError]=useState(''),[busy,setBusy]=useState(true);
 async function refresh(){setBusy(true);setError('');setData(null);try{const r=await fetch('/api/protection/inbox');const state=await r.json();if(!r.ok)throw Error(state.error);const w=state.watches.find(x=>x.id===params.id);if(!w)throw Error('Tracked position not found.');setWatch(w);setAlerts((state.alerts||[]).filter(a=>a.watch_id===params.id));if(!w.enabled)return;const p=w.position;const q=new URLSearchParams({symbol:p.symbol,contract:p.contract,lots:p.lots,entry:p.entry,simple:'1'});if(w.selected_put)q.set('preferredPut',w.selected_put);const response=await fetch('/api/protection?'+q);const d=await response.json();if(!response.ok)throw Error(d.error);if(!d.summary)throw Error('Planner API update pending.');setData(d);}catch(e){setError(e.message);}finally{setBusy(false);}}
 useEffect(()=>{refresh();const t=setInterval(refresh,300000);return()=>clearInterval(t);},[params.id]);
 async function stop(){setBusy(true);try{const r=await fetch('/api/protection/inbox',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'unwatch',id:params.id})});const d=await r.json();if(!r.ok)throw Error(d.error);router.replace('/protection/tracked');}catch(e){setError(e.message);}finally{setBusy(false);}}
 const summary=error?{direction:'unknown',directionLabel:'Data unavailable',tone:'muted',action:'Unable to advise',reason:'We could not get fresh data. Please try again.'}:data?.summary||watch?.summary;
 const put=data?.simple?.recommendation;
 return <div><Sidebar/><main className="md:ml-[200px] px-5 pt-20 pb-14 md:p-9"><div className="max-w-4xl mx-auto"><Link href="/protection/tracked" className="text-sm text-accent">← Tracked stocks</Link><div className="flex justify-between items-center mt-6 gap-3"><div><h1 className="text-3xl font-semibold">{watch?.position.symbol||'Position detail'}</h1>{watch&&<p className="text-soft text-sm mt-2">{watch.position.lots} lots · {watch.position.expiryDate} · bought at ₹{watch.position.entry}</p>}</div><button disabled={busy} onClick={refresh} className="rounded-xl border border-border px-4 py-3 text-sm">{busy?'Checking…':'Refresh'}</button></div>{error&&<p className="text-amber text-sm mt-4" role="alert">{error}</p>}{watch&&!watch.enabled&&<p className="text-amber mt-4">Monitoring stopped. Any assessment below is historical.</p>}<div className="mt-6">{busy?<LoadingCard/>:<ActionCard summary={summary}/>}</div>{put&&<div className="rounded-2xl bg-card border border-border p-5 mt-5"><p className="text-xs text-dim uppercase tracking-wider">Your planned protection</p><h2 className="text-xl font-semibold mt-2">{put.strike} PE · {put.expiryDate}</h2><p className="text-soft text-sm mt-2">{put.optionLots} lots · ask ₹{put.premium} · total ₹{Number(put.premiumTotal).toLocaleString('en-IN')}</p><p className="text-xs text-dim mt-2">{put.eligible?'Planning quote':'Indicative quote'} · This selection does not mean you own the put.</p></div>}{data&&<><div className="rounded-2xl border border-border p-5 mt-5"><h2 className="font-semibold">Already holding a put?</h2><p className="text-sm text-soft mt-2">{data.summary.hedgeReview}</p></div><ProtectionDetails key={data.asOf} data={data}/></>}{alerts.length>0&&<details className="rounded-2xl border border-border p-5 mt-5"><summary className="cursor-pointer font-semibold">Recent changes · {alerts.length}</summary>{alerts.slice(0,10).map(a=><div key={a.id} className="border-t border-border pt-3 mt-3"><p className="text-sm">{a.title}</p><p className="text-xs text-dim mt-1">{new Date(a.at*1000).toLocaleString()}</p></div>)}</details>}{watch?.enabled===1&&<button disabled={busy} onClick={stop} className="text-sm text-soft underline mt-7">Remove from tracking</button>}<p className="text-xs text-dim mt-5">Advisory only. Expiry payoffs are scenarios, not profit forecasts.</p></div></main></div>;
}
