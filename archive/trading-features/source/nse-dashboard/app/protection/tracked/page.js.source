'use client';
import {useEffect,useState,useRef} from 'react';
import Link from 'next/link';
import {Plus,ArrowUpRight,RefreshCw,Layers} from 'lucide-react';
import Sidebar from '../../components/Sidebar';
import ActionCard from '../ActionCard';
import LoadingCard from '../LoadingCard';
export default function Tracked(){
 const [data,setData]=useState(null),[error,setError]=useState(''),[busy,setBusy]=useState(true),[removing,setRemoving]=useState('');
 const revision=useRef(0);
 async function refresh(){const current=++revision.current;setBusy(true);try{const r=await fetch('/api/protection/inbox');const d=await r.json();if(!r.ok)throw Error(d.error);if(current!==revision.current)return;setData(d);setError('');}catch(e){if(current===revision.current){setError(e.message);setData(null);}}finally{if(current===revision.current)setBusy(false);}}
 async function remove(id){++revision.current;setBusy(false);setRemoving(id);setError('');try{const r=await fetch('/api/protection/inbox',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'unwatch',id})});const d=await r.json();if(!r.ok)throw Error(d.error);++revision.current;setBusy(false);setData(current=>({...current,watches:current.watches.filter(w=>w.id!==id)}));}catch(e){setError('Could not remove stock. Please try again.');}finally{setRemoving('');}}
 const watches=data?.watches?.filter(w=>w.enabled)||[];
 useEffect(()=>{refresh();const t=setInterval(refresh,60000);return()=>clearInterval(t);},[]);
 return <div><Sidebar/><main className="md:ml-[200px] px-5 pt-20 pb-14 md:p-9"><div className="max-w-5xl mx-auto"><div className="flex justify-between items-center"><p className="text-accent uppercase tracking-widest text-xs">Position protection</p><Link href="/protection" className="flex items-center gap-2 text-sm text-accent"><Plus size={17}/>Add position</Link></div><h1 className="text-3xl font-semibold mt-7">Your tracked stocks</h1><p className="text-soft mt-3">A clear next step for every position.</p><button disabled={busy} onClick={refresh} className="flex gap-2 items-center text-sm text-soft mt-5"><RefreshCw size={15} className={busy?'animate-spin':''}/>{busy?'Refreshing…':'Refresh'}</button>{error&&<p role="alert" className="text-amber mt-5">{error}</p>}<div className="grid md:grid-cols-2 gap-5 mt-6">{busy&&!data&&<><LoadingCard label="Loading tracked stocks…"/><LoadingCard label="Getting your suggestions…"/></>}{watches.map(w=><div key={w.id} className="rounded-2xl border border-border bg-card overflow-hidden"><Link href={'/protection/tracked/'+w.id} className="block p-4 hover:bg-accent/5 transition-colors"><div className="flex justify-between mb-4"><div><h2 className="font-semibold text-lg">{w.position.symbol}</h2><p className="text-xs text-soft mt-1">{w.position.lots} lots · {w.position.expiryDate} · entry ₹{w.position.entry}</p></div><ArrowUpRight size={19} className="text-accent"/></div>{!w.enabled&&<p className="text-xs text-amber mb-3">Monitoring stopped</p>}<ActionCard compact summary={w.summary}/><p className="text-xs text-soft mt-3">{w.latest?.simple?.recommendation?`${w.latest.simple.recommendation.strike} PE planned · not marked as bought`:'Put assessment pending'} · View details</p></Link><button disabled={!!removing} onClick={()=>remove(w.id)} className="w-full border-t border-border px-4 py-3 text-sm text-red hover:bg-red/10 disabled:opacity-50">{removing===w.id?'Removing…':'Remove from tracking'}</button></div>)}</div>{data&&!watches.length&&<div className="border border-dashed border-border rounded-2xl p-10 text-center mt-6"><Layers className="mx-auto text-accent"/><h2 className="text-xl mt-4">Start with your first position</h2><p className="text-soft text-sm mt-2">Save a futures trade to follow its protection signals.</p><Link href="/protection" className="inline-block bg-accent text-white rounded-xl px-5 py-3 mt-5">Add a position</Link></div>}<p className="text-xs text-dim mt-6">Saved positions are checked about every five minutes. Daily-candle rules; no automatic trades.</p></div></main></div>;
}
