import React,{useEffect,useState} from 'react';
import {View,Text,Pressable,Linking} from 'react-native';
import {request} from '@/lib/client';
import {useColors} from '@/lib/theme';
import {Card} from '@/components/ui';
export function HedgeInbox({data}:{data:any}){
 const c=useColors(),[state,setState]=useState<any>(null),[error,setError]=useState(''),[open,setOpen]=useState(false),[busy,setBusy]=useState(false);
 async function refresh(){try{setState(await request('/api/protection/inbox'));setError('');}catch(e:any){setError(e.message);}}
 useEffect(()=>{refresh();const t=setInterval(refresh,60000);return()=>clearInterval(t);},[]);
 async function act(body:any){setBusy(true);try{await request('/api/protection/inbox',{method:'POST',body});await refresh();}catch(e:any){setError(e.message);}finally{setBusy(false);}}
 const text=(s:string)=><Text style={{color:c.soft,fontSize:12,lineHeight:19,marginTop:7}}>{s}</Text>;
 return <Card style={{padding:18,marginTop:20}}><Text style={{color:c.text,fontSize:18,fontWeight:'700'}}>Advisory inbox {state?`· ${state.alerts.filter((a:any)=>a.unread).length} unread`:''}</Text>{text('Only saved watches are monitored while the app is closed. About five-minute polling; no trades or Telegram messages.')}<View style={{flexDirection:'row',gap:20,marginTop:10}}><Pressable onPress={refresh}>{text('Refresh')}</Pressable><Pressable onPress={()=>setOpen(!open)}>{text(open?'Hide inbox':'Open inbox')}</Pressable></View>{data&&<Pressable disabled={busy||!data.position.contractKey} onPress={()=>act({action:'watch',position:{symbol:data.position.symbol,contract:data.position.contractKey,entry:data.position.entry,lots:data.position.lots,expiryDate:data.position.expiryDate}})} style={{backgroundColor:c.accent,padding:13,borderRadius:10,marginTop:12,opacity:data.position.contractKey?1:.4}}><Text style={{color:'#fff',fontWeight:'700'}}>Monitor this futures position</Text></Pressable>}{!!error&&<Text style={{color:c.amber,fontSize:12,marginTop:10}}>{error}</Text>}{state&&text(`Worker: ${state.health?.error||(state.health?.last_success?new Date(Number(state.health.last_success)*1000).toLocaleString():'Waiting for first cycle')}`)}{open&&state&&<>{state.watches.filter((w:any)=>w.enabled).map((w:any)=><View key={w.id} style={{borderTopWidth:1,borderColor:c.border,marginTop:12,paddingTop:8}}>{text(`${w.position.symbol} · ${w.position.lots} lots · ${w.position.expiryDate}`)}{text(`Last check ${w.last_poll?new Date(w.last_poll*1000).toLocaleString():'Pending'}`)}<Pressable disabled={busy} onPress={()=>act({action:'unwatch',id:w.id})}>{text('Stop monitoring')}</Pressable></View>)}{!state.watches.some((w:any)=>w.enabled)&&text('No active watches. Add a position after calculating.')}{state.alerts.map((a:any)=>{let detail:any={};try{detail=JSON.parse(a.detail);}catch{}return <View key={a.id} style={{borderTopWidth:1,borderColor:c.border,paddingTop:10,marginTop:12}}><Text style={{color:c.text,fontWeight:'700'}}>{a.unread?'● ':''}{a.title}</Text>{text(new Date(a.at*1000).toLocaleString())}{detail.reasons?.map((x:string,i:number)=><View key={i}>{text(x)}</View>)}{detail.headlines?.map((x:any)=><Pressable key={x.url} onPress={()=>Linking.openURL(x.url)}>{text(`${x.title} · ${x.source} ↗`)}</Pressable>)}{detail.summary?.exit&&text(`Existing hedge review: ${detail.summary.exit}`)}{!!a.unread&&<Pressable disabled={busy} onPress={()=>act({action:'read',id:a.id})}>{text('Mark read')}</Pressable>}</View>;})}</>}</Card>;
}
