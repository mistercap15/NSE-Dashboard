import React,{useEffect,useState} from 'react';
import {View,Text,TextInput,Pressable,Linking} from 'react-native';
import AsyncStorage from '@react-native-async-storage/async-storage';
import {Card} from '@/components/ui';
import {useColors} from '@/lib/theme';
const money=(n:number)=>n.toLocaleString('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:2});
export function HedgeGuidance({data,put}:{data:any,put:any}){
 const c=useColors(),a=data.advice,[fill,setFill]=useState(''),[details,setDetails]=useState(false),[saved,setSaved]=useState('');
 const key='hedge-fill:'+data.position.contract+':'+put?.instrumentKey+':'+data.position.qty;
 useEffect(()=>{let active=true;setFill('');setSaved('');AsyncStorage.getItem(key).then(v=>{if(active)setFill(v||'');}).catch(()=>{});return()=>{active=false;};},[key]);
 const text=(s:string)=><Text style={{color:c.soft,fontSize:12,lineHeight:19,marginTop:8}}>{s}</Text>;
 if(!a)return text('Hedge guidance awaits the dashboard API update.');
 const q=put?.quote,valid=Number(fill)>0&&q?.fresh&&q.bid>0&&q.bid<=q.ask;
 const fut=data.futuresQuote?.fresh&&data.futuresMark>0?data.position.qty*(data.futuresMark-data.position.entry):null;
 return <Card style={{padding:20,marginTop:20}}><Text style={{color:c.accent,fontSize:11}}>HEDGE GUIDANCE · DAILY EVIDENCE</Text><Text style={{color:c.text,fontSize:24,fontWeight:'700',marginTop:9}}>{a.status}</Text>{text(a.trigger||a.reasons[0])}{text(`Evidence through ${a.asOf||'unknown'} · ${a.version}`)}{a.sector&&text(`Sector ${a.sector.name||'unknown'}: ${a.sector.status==='available'?(a.sector.weak?'weak peer breadth':'no broad weakness in sample'):'unknown'} · ${a.sector.coverage}`)}{a.news&&<>{text(`Company headlines · ${a.news.status}. ${a.news.reason}`)}{a.news.items.map((x:any)=><Pressable key={x.url} onPress={()=>Linking.openURL(x.url)}>{text(`${x.title} · ${x.source} · ${new Date(x.publishedAt).toLocaleDateString()}${x.eventReview?' · Event review':''} ↗`)}</Pressable>)}{!a.news.items.length&&text('No matching headlines returned; this does not establish absence of risk.')}</>}<Pressable onPress={()=>setDetails(!details)}>{text(details?'Hide evidence':'Evidence & missing data ▾')}</Pressable>{details&&<>{[...a.reasons,...a.missing].map((s:string,i:number)=><View key={i}>{text(s)}</View>)}{text(`Filings snapshot: ${a.filings?.asOf||'unavailable'}; not a live news feed.`)}{a.filings?.items?.map((x:any,i:number)=><View key={i}>{text(`${x.date}: ${x.text}`)}</View>)}</>}{text(a.caveat)}
 {put&&<><Text style={{color:c.text,fontWeight:'700',marginTop:18}}>Already own this {put.strike} PE?</Text>{text(`Actual premium per share for all ${put.optionLots} lots. Stored on this device only.`)}<TextInput accessibilityLabel="Actual put premium" keyboardType="decimal-pad" value={fill} onChangeText={v=>{setFill(v);setSaved('');}} placeholder="Actual premium ₹" placeholderTextColor={c.dim} style={{color:c.text,padding:12,borderWidth:1,borderColor:c.border,borderRadius:10,marginTop:10}}/><View style={{flexDirection:'row',gap:24}}><Pressable onPress={async()=>{try{if(Number(fill)>0)await AsyncStorage.setItem(key,fill);else await AsyncStorage.removeItem(key);setSaved('Saved');}catch{setSaved('Could not save');}}}>{text(saved||'Save fill')}</Pressable><Pressable onPress={async()=>{try{await AsyncStorage.removeItem(key);setFill('');setSaved('');}catch{setSaved('Could not clear');}}}>{text('Clear')}</Pressable></View>{Number(fill)>0&&<>{text(a.exit)}{text(`Put P&L at bid: ${valid?money(data.position.qty*(q.bid-Number(fill))):'Fresh two-sided quote required'}`)}{text(`Combined marked P&L: ${valid&&fut!=null?money(fut+data.position.qty*(q.bid-Number(fill))):'Fresh futures and put quotes required'}`)}{text(`Selling all puts leaves ${data.position.qty} futures shares unprotected. A further 1% futures fall costs about ${money(data.position.qty*(data.futuresMark||data.spot)*.01)}. Fees excluded; exit depth unverified. Below, new-put scenarios use ask rather than this saved fill.`)}</>}</>}
 </Card>;
}
