import React,{useEffect,useState} from 'react';
import {ScrollView,View,Text,TextInput,Pressable} from 'react-native';
import Ionicons from '@expo/vector-icons/Ionicons';
import Svg,{Polyline,Line,Text as SvgText} from 'react-native-svg';
import {HedgeGuidance} from '@/components/HedgeGuidance';
import {Card} from '@/components/ui';
import {useColors} from '@/lib/theme';
const money=(v:any)=>v==null?'—':Number(v).toLocaleString('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:2});
const month=(d:string)=>new Date(d+'T12:00:00').toLocaleDateString('en-IN',{month:'short',year:'numeric'});
export function ProtectionDetails({data}: {data:any}){
 const c=useColors();const symbol=data.position.symbol;const [selected,setSelected]=useState(data.simple?.recommendation?.instrumentKey||''),[scenario,setScenario]=useState(100),[details,setDetails]=useState(false),[open,setOpen]=useState(false),[evidence,setEvidence]=useState(false);
 const alternatives=(data?.candidates||[]).filter((x:any)=>x.quote.bid>0&&x.premium>=x.quote.bid).sort((a:any,b:any)=>Math.abs(a.strike-data.spot)-Math.abs(b.strike-data.spot));
 const put=alternatives.find((x:any)=>x.instrumentKey===selected)||data?.simple?.recommendation,p=data?.position;
 const comparison=[put,...alternatives.filter((x:any)=>x.instrumentKey!==put?.instrumentKey)].filter(Boolean).slice(0,4);
 const pnl=(price:number,hedged:boolean)=>p?p.qty*(price-p.entry+(hedged&&put?Math.max(put.strike-price,0)-put.premium:0)):0;
 const prices=data?Array.from({length:61},(_,i)=>data.spot*(.7+i*.01)):[];const values=prices.flatMap(s=>[pnl(s,false),pnl(s,true)]),lo=Math.min(0,...values),hi=Math.max(1,...values);const y=(n:number)=>175-(n-lo)/(hi-lo)*150;
 const hint=(s:string)=><Text style={{color:c.soft,fontSize:12,lineHeight:19,marginTop:8}}>{s}</Text>;
 return <View><Pressable onPress={()=>setOpen(!open)} style={{paddingVertical:22}}><Text style={{color:c.accent,fontWeight:'700'}}>Payoff & compare puts {open?'−':'+'}</Text></Pressable>{open&&<View> {put&&<><Card style={{padding:18,marginTop:18}}><Text style={{color:c.text,fontWeight:'700',fontSize:18}}>Compare PE strikes</Text>{hint('Select a strike to update the graph. Compare the selected put and three nearest alternatives at the chosen move. Expiry scenarios, not forecasts.')}<ScrollView horizontal style={{marginTop:14}}>{alternatives.map((x:any)=><Pressable key={x.instrumentKey} onPress={()=>setSelected(x.instrumentKey)} style={{padding:12,marginRight:8,borderRadius:10,borderWidth:1,borderColor:x.instrumentKey===put.instrumentKey?c.accent:c.border}}><Text style={{color:c.text}}>{x.strike} PE</Text><Text style={{color:c.soft,fontSize:11,marginTop:4}}>{money(x.premium)}{x.eligible?'':' · indicative'}</Text></Pressable>)}</ScrollView>{hint(`Expiry move ${scenario-100}% from spot · No put ${money(pnl(data.spot*scenario/100,false))}`)}{comparison.map((x:any)=><View key={x.instrumentKey} style={{flexDirection:'row',justifyContent:'space-between',marginTop:12}}><Text style={{color:c.soft}}>{x.strike} PE</Text><Text style={{color:c.text,fontWeight:'700'}}>{money(p.qty*(data.spot*scenario/100-p.entry+Math.max(x.strike-data.spot*scenario/100,0)-x.premium))}</Text></View>)}</Card><Card stripe={c.accent} style={{padding:22,marginTop:22}}><Text style={{color:c.accent,fontSize:10,fontWeight:'800',letterSpacing:1.5}}>{put.eligible?'SELECTED PAYOFF SCENARIO':'INDICATIVE PAYOFF SCENARIO'}</Text><Text style={{color:c.text,fontSize:36,fontWeight:'800',letterSpacing:-1,marginTop:12}}>{put.strike} PE</Text>{hint(`${symbol} · ${put.expiryDate} · ${put.optionLots} lots (${p.qty} shares)`)}<View style={{flexDirection:'row',gap:18,marginTop:22}}><View style={{flex:1}}><Text style={{color:c.soft,fontSize:11}}>Put price · ask</Text><Text style={{color:c.text,fontSize:22,fontWeight:'700',marginTop:5}}>{money(put.premium)}</Text></View><View style={{flex:1}}><Text style={{color:c.soft,fontSize:11}}>Total premium</Text><Text style={{color:c.text,fontSize:22,fontWeight:'700',marginTop:5}}>{money(put.premiumTotal)}</Text></View></View><View style={{padding:16,backgroundColor:c.bg,borderRadius:12,marginTop:20}}><Text style={{color:c.soft,fontSize:11}}>Maximum loss at matched expiry*</Text><Text style={{color:c.text,fontSize:27,fontWeight:'800',marginTop:5}}>{money(put.maxLoss)}</Text></View>{!put.eligible&&<Text style={{color:c.amber,fontSize:11,lineHeight:17,marginTop:14}}>Planning quote only. Closed market, stale/wide quotes or insufficient quantity may prevent this fill. Refresh before buying.</Text>}</Card>
 <Card style={{padding:18,marginTop:16}}><Text style={{color:c.text,fontSize:18,fontWeight:'700'}}>What happens at expiry?</Text><View style={{flexDirection:'row',gap:18,marginTop:12}}><Text style={{color:'#6495ed',fontSize:11}}>━ Without put</Text><Text style={{color:c.green,fontSize:11}}>━ With put</Text></View>
 <Svg width="100%" height={215} viewBox="0 0 320 215"><Line x1="40" x2="310" y1={y(0)} y2={y(0)} stroke={c.dim} strokeDasharray="3 3"/><Polyline points={prices.map((s,i)=>`${40+i*4.5},${y(pnl(s,false))}`).join(' ')} fill="none" stroke="#6495ed" strokeWidth="2"/><Polyline points={prices.map((s,i)=>`${40+i*4.5},${y(pnl(s,true))}`).join(' ')} fill="none" stroke="#22c55e" strokeWidth="3"/><SvgText x="0" y="25" fill={c.dim} fontSize="10">{Math.round(hi/1000)}k</SvgText><SvgText x="0" y="175" fill={c.dim} fontSize="10">{Math.round(lo/1000)}k</SvgText><SvgText x="40" y="200" fill={c.dim} fontSize="10">{Math.round(data.spot*.7)}</SvgText><SvgText x="265" y="200" fill={c.dim} fontSize="10">{Math.round(data.spot*1.3)}</SvgText></Svg>
 <Text style={{color:c.soft,fontSize:12}}>If the stock closes at {money(data.spot*scenario/100)}</Text><View style={{flexDirection:'row',flexWrap:'wrap',gap:7,marginTop:12}}>{[80,90,95,96,97,98,99,100,101,102,103,104,105,110,120].map(n=><Pressable key={n} onPress={()=>setScenario(n)} style={{padding:10,borderRadius:9,backgroundColor:scenario===n?c.accent:c.bg}}><Text style={{color:scenario===n?'#fff':c.soft,fontSize:11}}>{n===100?'0%':`${n>100?'+':''}${n-100}%`}</Text></Pressable>)}</View><View style={{flexDirection:'row',gap:15,marginTop:18}}><View style={{flex:1}}><Text style={{color:c.soft,fontSize:11}}>Without put</Text><Text style={{color:c.text,fontSize:18,fontWeight:'700',marginTop:5}}>{money(pnl(data.spot*scenario/100,false))}</Text></View><View style={{flex:1}}><Text style={{color:c.soft,fontSize:11}}>With put</Text><Text style={{color:c.green,fontSize:18,fontWeight:'700',marginTop:5}}>{money(pnl(data.spot*scenario/100,true))}</Text></View></View></Card>
 <Text style={{color:c.dim,fontSize:10,lineHeight:16,marginTop:14}}>*Includes put premium; excludes brokerage, taxes and funding. Assumes full quantity held to matched expiry. Earlier exits and broker liquidation can differ. No orders placed.</Text>
 <Pressable onPress={()=>setDetails(!details)} style={{flexDirection:'row',justifyContent:'space-between',paddingVertical:20}}><Text style={{color:c.soft,fontSize:12}}>Why this put? · Quote details</Text><Ionicons name={details?'chevron-up':'chevron-down'} color={c.dim} size={16}/></Pressable>{details&&<View>{hint(data.simple.method)}{hint(`Bid ${money(put.quote.bid)} · ask ${money(put.premium)} · ${put.quote.askQty} shares at ask · ${put.quote.at?new Date(put.quote.at).toLocaleString():'Time unavailable'}`)}{put.issues.map((s:string)=><Text key={s} style={{color:c.amber,fontSize:11,marginTop:8}}>{s}</Text>)}{hint(`Suggested target ${money(data.target.price)}. ${data.target.reason}`)}</View>}</>}
</View>}<Pressable onPress={()=>setEvidence(!evidence)} style={{paddingVertical:18}}><Text style={{color:c.soft,fontWeight:'700'}}>Full evidence & my put fill {evidence?'−':'+'}</Text></Pressable>{evidence&&<HedgeGuidance data={data} put={put}/>}</View>;
}
