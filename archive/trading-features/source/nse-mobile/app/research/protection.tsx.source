import React,{useEffect,useState} from 'react';
import {ScrollView,View,Text,TextInput,Pressable,ActivityIndicator} from 'react-native';
import {router} from 'expo-router';
import Ionicons from '@expo/vector-icons/Ionicons';
import {StockSearch} from '@/components/StockSearch';
import {Card} from '@/components/ui';
import {HedgeAction} from '@/components/HedgeAction';
import {HedgeLoading} from '@/components/HedgeLoading';
import {useColors} from '@/lib/theme';
import {request} from '@/lib/client';
export default function Protection(){
 const c=useColors();const [symbol,setSymbol]=useState('HINDUNILVR'),[contracts,setContracts]=useState<any[]>([]),[contract,setContract]=useState(''),[lots,setLots]=useState(''),[entry,setEntry]=useState(''),[busy,setBusy]=useState(false),[saving,setSaving]=useState(false),[error,setError]=useState(''),[data,setData]=useState<any>(null),[selected,setSelected]=useState('');
 useEffect(()=>{let active=true;setContract('');setContracts([]);setData(null);setError('');request<any>('/api/protection',{params:{symbol}}).then(d=>{if(!active)return;setContracts(d.contracts||[]);setContract(d.contracts?.[0]?.instrumentKey||'');if(!d.contracts?.length)setError('No listed futures for this stock.');}).catch(e=>{if(active)setError(e.message);});return()=>{active=false;};},[symbol]);
 const valid=!!contract&&Number.isInteger(Number(lots))&&Number(lots)>=1&&Number(lots)<=100&&Number(entry)>0;
 useEffect(()=>{let active=true;setData(null);setSelected('');if(!valid){setBusy(false);return;}setBusy(true);setError('');const t=setTimeout(()=>request<any>('/api/protection',{params:{symbol,contract,lots,entry,simple:'1'}}).then(d=>{if(!active)return;if(!d.summary)throw Error('The updated planner API is awaiting deployment.');setData(d);setSelected(d.simple?.recommendation?.instrumentKey||'');}).catch(e=>{if(active)setError(e.message);}).finally(()=>{if(active)setBusy(false);}),800);return()=>{active=false;clearTimeout(t);};},[symbol,contract,lots,entry,valid]);
 const change=(setter:any,value:string)=>{setter(value);setData(null);setError('');};
 const put=data?.candidates?.find((p:any)=>p.instrumentKey===selected);
 const choices=(data?.candidates||[]).filter((p:any)=>p.quote.bid>0&&p.premium>=p.quote.bid).sort((a:any,b:any)=>(a.instrumentKey===selected?-1:b.instrumentKey===selected?1:Math.abs(a.strike-data.spot)-Math.abs(b.strike-data.spot)));
 async function save(){if(!data||saving)return;setSaving(true);try{const p=data.position;const d=await request<any>('/api/protection/inbox',{method:'POST',body:{action:'watch',selectedPut:selected||null,position:{symbol:p.symbol,contract:p.contractKey,lots:p.lots,entry:p.entry,expiryDate:p.expiryDate}}});router.push({pathname:'/research/protection-detail',params:{id:d.id}});}catch(e:any){setError(e.message);}finally{setSaving(false);}}
 return <ScrollView style={{backgroundColor:c.bg}} contentContainerStyle={{padding:20,paddingBottom:60}} keyboardShouldPersistTaps="handled"><Pressable onPress={()=>router.push('/research/protection-tracked')} style={{flexDirection:'row',justifyContent:'flex-end',alignItems:'center',gap:7,paddingVertical:10}}><Text style={{color:c.accent,fontSize:13,fontWeight:'700'}}>View tracked stocks</Text><Ionicons name="arrow-forward" size={17} color={c.accent}/></Pressable><Text style={{color:c.text,fontSize:32,fontWeight:'800',letterSpacing:-1,marginTop:16}}>Add your position.</Text><Text style={{color:c.soft,fontSize:14,marginTop:9}}>Four details. A put plan. One clear next step.</Text><Card style={{padding:20,marginTop:24}}><Text style={{color:c.dim,fontSize:10,letterSpacing:1.5}}>01 · YOUR FUTURES TRADE</Text><Text style={{color:c.soft,fontSize:12,marginTop:20,marginBottom:10}}>Stock · {symbol}</Text><View pointerEvents={saving?'none':'auto'}><StockSearch onSelect={v=>change(setSymbol,v)}/></View><Text style={{color:c.soft,fontSize:12,marginTop:20}}>Expiry</Text><View style={{flexDirection:'row',flexWrap:'wrap',gap:8,marginTop:10}}>{contracts.map(k=><Pressable disabled={saving} key={k.instrumentKey} onPress={()=>change(setContract,k.instrumentKey)} style={{padding:12,borderRadius:10,borderWidth:1,borderColor:contract===k.instrumentKey?c.accent:c.border,backgroundColor:contract===k.instrumentKey?c.accentBg:c.bg}}><Text style={{color:contract===k.instrumentKey?c.accent:c.soft,fontSize:12,fontWeight:'700'}}>{new Date(k.expiryDate+'T12:00:00').toLocaleDateString('en-IN',{day:'numeric',month:'short'})}</Text></Pressable>)}</View><View style={{flexDirection:'row',gap:14,marginTop:20}}>{[['Lots',lots,setLots],['Buying price ₹',entry,setEntry]].map(([label,value,setter]:any)=><View key={label} style={{flex:1}}><Text style={{color:c.soft,fontSize:12}}>{label}</Text><TextInput accessibilityLabel={label} editable={!saving} keyboardType="decimal-pad" value={value} placeholder={label==='Lots'?'e.g. 5':'Actual fill'} placeholderTextColor={c.dim} onChangeText={v=>change(setter,v)} style={{color:c.text,fontSize:18,backgroundColor:c.bg,borderWidth:1,borderColor:c.border,borderRadius:12,padding:13,marginTop:9}}/></View>)}</View><View style={{borderTopWidth:1,borderTopColor:c.border,marginTop:24,paddingTop:20}}><Text style={{color:c.dim,fontSize:10,letterSpacing:1.5}}>02 · SUGGESTED PUT</Text>{busy?<View style={{padding:20}}><ActivityIndicator color={c.accent}/><Text style={{color:c.soft,textAlign:'center',marginTop:8}}>Checking your position…</Text></View>:data?<><ScrollView horizontal style={{marginTop:15}}>{choices.map((p:any)=><Pressable key={p.instrumentKey} disabled={saving} onPress={()=>setSelected(p.instrumentKey)} style={{padding:13,marginRight:8,borderRadius:12,borderWidth:1,borderColor:p.instrumentKey===selected?c.accent:c.border,backgroundColor:p.instrumentKey===selected?c.accentBg:c.bg}}><Text style={{color:c.text,fontWeight:'700'}}>{p.strike} PE</Text><Text style={{color:c.soft,fontSize:11,marginTop:5}}>₹{p.premium}</Text></Pressable>)}</ScrollView><Text style={{color:c.soft,fontSize:12,marginTop:12}}>{put?`${put.optionLots} lots · total premium ₹${Number(put.premiumTotal).toLocaleString('en-IN')}`:'No usable quote. You can still track risk.'}</Text><Text style={{color:c.dim,fontSize:10,marginTop:7}}>Selected for planning; not a purchased hedge.</Text></>:<Text style={{color:c.soft,fontSize:13,lineHeight:20,marginTop:16}}>Complete your trade details. A matching PE will be preselected automatically.</Text>}</View>{!!error&&<Text accessibilityRole="alert" style={{color:c.red,marginTop:15,fontSize:12}}>{error}</Text>}<Pressable disabled={!data||busy||saving} onPress={save} style={{backgroundColor:c.accent,padding:17,borderRadius:13,marginTop:24,opacity:!data||busy||saving?.4:1}}><Text style={{color:'#fff',textAlign:'center',fontWeight:'800'}}>{saving?'Adding…':'Add to track'}</Text></Pressable><Text style={{color:c.dim,fontSize:10,textAlign:'center',marginTop:10}}>No orders are placed.</Text></Card>{busy?<View style={{marginTop:20}}><HedgeLoading/></View>:data&&<View style={{marginTop:20}}><HedgeAction summary={data.summary}/></View>}<Text style={{color:c.dim,fontSize:11,lineHeight:18,marginTop:18}}>Your tracked stock shows the next action first. Payoff comparisons and evidence are available in its detail view.</Text></ScrollView>;
}
