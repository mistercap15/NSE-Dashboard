import React,{useEffect,useState} from 'react';
import {ScrollView,View,Text,Pressable} from 'react-native';
import {router,useLocalSearchParams} from 'expo-router';
import {useColors} from '@/lib/theme';
import {request} from '@/lib/client';
import {HedgeAction} from '@/components/HedgeAction';
import {HedgeLoading} from '@/components/HedgeLoading';
import {ProtectionDetails} from '@/components/ProtectionDetails';
export default function Detail(){
 const {id}=useLocalSearchParams<{id:string}>();const c=useColors();const [alerts,setAlerts]=useState<any[]>([]),[history,setHistory]=useState(false),[watch,setWatch]=useState<any>(null),[data,setData]=useState<any>(null),[busy,setBusy]=useState(true),[error,setError]=useState('');
 async function refresh(){setBusy(true);setError('');setData(null);try{const state=await request<any>('/api/protection/inbox');const w=state.watches.find((x:any)=>x.id===id);if(!w)throw Error('Tracked position not found.');setWatch(w);setAlerts((state.alerts||[]).filter((a:any)=>a.watch_id===id));if(!w.enabled)return;const p=w.position;const d=await request<any>('/api/protection',{params:{symbol:p.symbol,contract:p.contract,lots:p.lots,entry:p.entry,simple:'1',...(w.selected_put?{preferredPut:w.selected_put}:{})}});if(!d.summary)throw Error('Planner API update pending.');setData(d);}catch(e:any){setError(e.message);}finally{setBusy(false);}}
 useEffect(()=>{refresh();const t=setInterval(refresh,300000);return()=>clearInterval(t);},[id]);
 async function stop(){setBusy(true);try{await request('/api/protection/inbox',{method:'POST',body:{action:'unwatch',id}});router.replace('/research/protection-tracked');}catch(e:any){setError(e.message);}finally{setBusy(false);}}
 const summary=error?{direction:'unknown',directionLabel:'Data unavailable',tone:'muted',action:'Unable to advise',reason:'We could not get fresh data. Please try again.'}:data?.summary||watch?.summary;const put=data?.simple?.recommendation;
 return <ScrollView style={{backgroundColor:c.bg}} contentContainerStyle={{padding:20,paddingBottom:60}}><View style={{flexDirection:'row',justifyContent:'space-between',alignItems:'center'}}><Text style={{color:c.text,fontSize:28,fontWeight:'800'}}>{watch?.position.symbol||'Position detail'}</Text><Pressable disabled={busy} onPress={refresh}><Text style={{color:c.accent,fontSize:12}}>{busy?'Checking…':'Refresh'}</Text></Pressable></View>{watch&&<Text style={{color:c.soft,fontSize:12,marginTop:10}}>{watch.position.lots} lots · {watch.position.expiryDate} · bought ₹{watch.position.entry}</Text>}{!!error&&<Text style={{color:c.amber,fontSize:12,marginTop:15}}>{error}</Text>}{watch&&!watch.enabled&&<Text style={{color:c.amber,marginTop:15}}>Monitoring stopped. Assessment is historical.</Text>}<View style={{marginTop:24}}>{busy?<HedgeLoading/>:<HedgeAction summary={summary}/>}</View>{put&&<View style={{backgroundColor:c.card,borderWidth:1,borderColor:c.border,borderRadius:20,padding:20,marginTop:20}}><Text style={{color:c.dim,fontSize:10,letterSpacing:1}}>YOUR PLANNED PROTECTION</Text><Text style={{color:c.text,fontSize:24,fontWeight:'800',marginTop:12}}>{put.strike} PE</Text><Text style={{color:c.soft,fontSize:12,marginTop:9}}>{put.expiryDate} · {put.optionLots} lots · ask ₹{put.premium}</Text><Text style={{color:c.text,fontSize:16,marginTop:10}}>Total ₹{Number(put.premiumTotal).toLocaleString('en-IN')}</Text><Text style={{color:c.dim,fontSize:10,marginTop:10}}>{put.eligible?'Planning quote':'Indicative quote'} · Not marked as bought.</Text></View>}{data&&<><View style={{padding:20,borderWidth:1,borderColor:c.border,borderRadius:20,marginTop:20}}><Text style={{color:c.text,fontWeight:'700'}}>Already holding a put?</Text><Text style={{color:c.soft,fontSize:12,lineHeight:19,marginTop:9}}>{data.summary.hedgeReview}</Text></View><ProtectionDetails key={data.asOf} data={data}/></>}{alerts.length>0&&<View style={{marginTop:15}}><Pressable onPress={()=>setHistory(!history)} style={{paddingVertical:16}}><Text style={{color:c.soft,fontWeight:'700'}}>Recent changes · {alerts.length} {history?'−':'+'}</Text></Pressable>{history&&alerts.slice(0,10).map(a=><View key={a.id} style={{borderTopWidth:1,borderTopColor:c.border,paddingVertical:12}}><Text style={{color:c.text,fontSize:12}}>{a.title}</Text><Text style={{color:c.dim,fontSize:10,marginTop:5}}>{new Date(a.at*1000).toLocaleString()}</Text></View>)}</View>}{watch?.enabled===1&&<Pressable disabled={busy} onPress={stop} style={{paddingVertical:18}}><Text style={{color:c.soft,textDecorationLine:'underline'}}>Remove from tracking</Text></Pressable>}<Text style={{color:c.dim,fontSize:11,lineHeight:18}}>Advisory only. Expiry payoffs are scenarios, not profit forecasts.</Text></ScrollView>;
}
