import React,{useState,useCallback,useRef} from 'react';
import {ScrollView,View,Text,Pressable} from 'react-native';
import {router,useFocusEffect} from 'expo-router';
import {useColors} from '@/lib/theme';
import {request} from '@/lib/client';
import {HedgeAction} from '@/components/HedgeAction';
import {HedgeLoading} from '@/components/HedgeLoading';
export default function Tracked(){
 const c=useColors();const [data,setData]=useState<any>(null),[error,setError]=useState(''),[busy,setBusy]=useState(true),[removing,setRemoving]=useState('');
 const revision=useRef(0);
 async function refresh(){const current=++revision.current;setBusy(true);try{const next=await request('/api/protection/inbox');if(current!==revision.current)return;setData(next);setError('');}catch(e:any){if(current===revision.current){setError(e.message);setData(null);}}finally{if(current===revision.current)setBusy(false);}}
 async function remove(id:string){++revision.current;setBusy(false);setRemoving(id);setError('');try{await request('/api/protection/inbox',{method:'POST',body:{action:'unwatch',id}});++revision.current;setBusy(false);setData((current:any)=>({...current,watches:current.watches.filter((w:any)=>w.id!==id)}));}catch{setError('Could not remove stock. Please try again.');}finally{setRemoving('');}}
 const watches=data?.watches?.filter((w:any)=>w.enabled)||[];
 useFocusEffect(useCallback(()=>{refresh();const t=setInterval(refresh,60000);return()=>clearInterval(t);},[]));
 return <ScrollView style={{backgroundColor:c.bg}} contentContainerStyle={{padding:20,paddingBottom:60}}><Text style={{color:c.text,fontSize:30,fontWeight:'800',letterSpacing:-.7}}>Your tracked stocks</Text><Text style={{color:c.soft,fontSize:13,marginTop:10}}>A clear next step for every position.</Text><View style={{flexDirection:'row',justifyContent:'space-between',marginTop:20}}><Pressable disabled={busy} onPress={refresh}><Text style={{color:c.accent}}>{busy?'Refreshing…':'Refresh'}</Text></Pressable><Pressable onPress={()=>router.push('/research/protection')}><Text style={{color:c.accent}}>+ Add position</Text></Pressable></View>{!!error&&<Text style={{color:c.amber,marginTop:20}}>{error}</Text>}{busy&&!data&&<View style={{marginTop:24}}><HedgeLoading label="Loading tracked stocks…"/></View>}{watches.map((w:any)=><View key={w.id} style={{marginTop:22,borderWidth:1,borderColor:c.border,borderRadius:22,overflow:'hidden'}}><Pressable onPress={()=>router.push({pathname:'/research/protection-detail',params:{id:w.id}})} style={{padding:15,backgroundColor:c.card}}><Text style={{color:c.text,fontSize:21,fontWeight:'800'}}>{w.position.symbol} ↗</Text><Text style={{color:c.soft,fontSize:12,marginTop:6,marginBottom:15}}>{w.position.lots} lots · {w.position.expiryDate} · ₹{w.position.entry}</Text>{!w.enabled&&<Text style={{color:c.amber,fontSize:12,marginBottom:10}}>Monitoring stopped</Text>}<HedgeAction compact summary={w.summary}/><Text style={{color:c.soft,fontSize:11,marginTop:12}}>{w.latest?.simple?.recommendation?`${w.latest.simple.recommendation.strike} PE planned`:'Put assessment pending'} · View details</Text></Pressable><Pressable disabled={!!removing} onPress={()=>remove(w.id)} accessibilityLabel={'Remove '+w.position.symbol+' from tracking'} style={{padding:15,borderTopWidth:1,borderTopColor:c.border,backgroundColor:c.card}}><Text style={{color:c.red,fontSize:13,textAlign:'center'}}>{removing===w.id?'Removing…':'Remove from tracking'}</Text></Pressable></View>)}{data&&!watches.length&&<View style={{padding:30,marginTop:30,borderWidth:1,borderColor:c.border,borderRadius:20}}><Text style={{color:c.text,fontSize:21,fontWeight:'700'}}>Add your first position</Text><Text style={{color:c.soft,marginTop:10}}>Save a futures trade to follow its protection signals.</Text></View>}<Text style={{color:c.dim,fontSize:11,lineHeight:18,marginTop:22}}>Checked about every five minutes. Daily-candle rules; no automatic trades.</Text></ScrollView>;
}
